  "Sequenze": {
   "rungs": [
    {
     "cmt": "START RESET ROBOT DA HMI",
     "chain": [
      "P_On",
      "Robot_Ready",
      "^V_P_Start_Reset",
      "(S Start_Reset)"
     ]
    },
    {
     "cmt": "HOMING ASSE Y",
     "chain": [
      "Start_Reset",
      {
       "fb": "MC_Home",
       "inst": "Home_Y",
       "p": {
        "Axis": "MC_Y",
        "OUT:Axis": "MC_Y"
       }
      }
     ]
    },
    {
     "cmt": "HOMING ASSE X DOPO Y",
     "chain": [
      "Home_Y.Done",
      {
       "fb": "MC_Home",
       "inst": "Home_X",
       "p": {
        "Axis": "MC_X",
        "OUT:Axis": "MC_X"
       }
      }
     ]
    },
    {
     "cmt": "FINE SEQUENZA DI RESET",
     "chain": [
      "Home_X.Done",
      "(S End_Reset)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      "Home_X.Done",
      "(R Start_Reset)"
     ]
    },
    {
     "cmt": "MACCHINA OK PER MOVIMENTAZIONE",
     "chain": [
      "Robot_Ready",
      "End_Reset",
      "(Macchina_OK)"
     ]
    },
    {
     "cmt": "READY MOVIMENTAZIONE",
     "chain": [
      "Macchina_OK",
      "/Movim_Prenotati",
      "(Ready_Movimentazione)"
     ]
    },
    {
     "cmt": "CLOCK MOVIMENTAZIONE",
     "chain": [
      "P_On"
     ],
     "out": [
      [
       {
        "f": "Get100msClk",
        "p": {}
       },
       {
        "f": "@Inc",
        "p": {
         "InOut": "Clock_Movimenti",
         "OUT:InOut": "Clock_Movimenti"
        }
       }
      ],
      [
       {
        "or": [
         "Movim_Prenotati",
         {
          "f": ">",
          "p": {
           "In1": "Clock_Movimenti",
           "In2": "5"
          }
         }
        ]
       },
       {
        "f": "MOVE",
        "p": {
         "In": "0",
         "OUT:Out": "Clock_Movimenti"
        }
       }
      ]
     ]
    },
    {
     "cmt": "PRENOTAZIONE DA STAZIONE A VERSO VASCA 1",
     "chain": [
      "Ready_Movimentazione",
      "IN_PEZZO_A",
      {
       "f": "=",
       "p": {
        "In1": "Clock_Movimenti",
        "In2": "INT#1"
       }
      },
      "/Mem_V1",
      "(S Prelievo_A)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      "Ready_Movimentazione",
      "IN_PEZZO_A",
      {
       "f": "=",
       "p": {
        "In1": "Clock_Movimenti",
        "In2": "INT#1"
       }
      },
      "/Mem_V1",
      "(S Deposito_V1)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      "Prelievo_A",
      "Deposito_V1",
      "(Look_A)"
     ]
    },
    {
     "cmt": "PRENOTAZIONE DA STAZIONE B VERSO VASCA 2",
     "chain": [
      "Ready_Movimentazione",
      "IN_PEZZO_B",
      {
       "f": "=",
       "p": {
        "In1": "Clock_Movimenti",
        "In2": "INT#2"
       }
      },
      "/Mem_V2",
      "(S Prelievo_B)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      "Ready_Movimentazione",
      "IN_PEZZO_B",
      {
       "f": "=",
       "p": {
        "In1": "Clock_Movimenti",
        "In2": "INT#2"
       }
      },
      "/Mem_V2",
      "(S Deposito_V2)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      "Prelievo_B",
      "Deposito_V2",
      "(Look_B)"
     ]
    },
    {
     "cmt": "MOVIMENTI PRENOTATI",
     "chain": [
      {
       "or": [
        "Prelievo_A",
        "Prelievo_B"
       ]
      },
      "(Movim_Prenotati)"
     ]
    },
    {
     "cmt": "MEMORIA VASCA 1 OCCUPATA",
     "chain": [
      "End_Movimenti",
      "Deposito_V1",
      "(S Mem_V1)"
     ]
    },
    {
     "cmt": "MEMORIA VASCA 2 OCCUPATA",
     "chain": [
      "End_Movimenti",
      "Deposito_V2",
      "(S Mem_V2)"
     ]
    },
    {
     "cmt": "SVUOTO VASCA 1 DA HMI",
     "chain": [
      "V_P_Svuota_V1",
      "(R Mem_V1)"
     ]
    },
    {
     "cmt": "SVUOTO VASCA 2 DA HMI",
     "chain": [
      "V_P_Svuota_V2",
      "(R Mem_V2)"
     ]
    },
    {
     "cmt": "RESETTO TUTTI I MOVIMENTI",
     "chain": [
      {
       "or": [
        "End_Movimenti",
        "IN_RESET"
       ]
      },
      "(R Prelievo_A)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      {
       "or": [
        "End_Movimenti",
        "IN_RESET"
       ]
      },
      "(R Prelievo_B)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      {
       "or": [
        "End_Movimenti",
        "IN_RESET"
       ]
      },
      "(R Deposito_V1)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      {
       "or": [
        "End_Movimenti",
        "IN_RESET"
       ]
      },
      "(R Deposito_V2)"
     ]
    }
   ],
