  "Trasf_Dati": {
   "rungs": [
    {
     "cmt": "CALCOLO QUOTE PER MOVIMENTAZIONE",
     "chain": [
      "P_On",
      {
       "ist": "(*Quote movimentazione da PRESA a DEPOSITO*)\r\n\r\n(*MOV1 asse X su presa*)\r\nDistance1:=X_PRESA;\r\n\r\n(*MOV2 asse Y discesa presa*)\r\nDistance2:=Y_PRESA;\r\n\r\n(*MOV3 asse Y salita con pezzo*)\r\nDistance3:=LREAL#0.0;\r\n\r\n(*MOV4 asse X verso deposito*)\r\nDistance4:=X_DEPOSITO;\r\n\r\n(*MOV5 asse Y discesa deposito veloce*)\r\nDistance5:=Y_DEPOSITO-LREAL#50.0;\r\n\r\n(*MOV5A asse Y avvicinamento lento*)\r\nDistance5A:=Y_DEPOSITO;\r\n\r\n(*MOV6 asse Y salita dopo deposito*)\r\nDistance6:=LREAL#0.0;\r\n\r\n(*MOV7 asse X riposo*)\r\nDistance7:=X_RIPOSO;\r\n"
      }
     ]
    },
    {
     "cmt": "DATI DI PRESA DA STAZIONE A",
     "chain": [
      "Prelievo_A",
      {
       "ist": "X_PRESA:=X_STAZ_A;\r\nY_PRESA:=Y_STAZ_A;\r\n"
      }
     ]
    },
    {
     "cmt": "DATI DI PRESA DA STAZIONE B",
     "chain": [
      "Prelievo_B",
      {
       "ist": "X_PRESA:=X_STAZ_B;\r\nY_PRESA:=Y_STAZ_B;\r\n"
      }
     ]
    },
    {
     "cmt": "DATI DI DEPOSITO VASCA 1",
     "chain": [
      "Deposito_V1",
      {
       "ist": "X_DEPOSITO:=X_V1;\r\nY_DEPOSITO:=Y_V1;\r\n"
      }
     ]
    },
    {
     "cmt": "DATI DI DEPOSITO VASCA 2",
     "chain": [
      "Deposito_V2",
      {
       "ist": "X_DEPOSITO:=X_V2;\r\nY_DEPOSITO:=Y_V2;\r\n"
      }
     ]
    }
   ],
