  "Movimentazione": {
   "rungs": [
    {
     "cmt": "RITARDO START CATENA DI MOVIMENTAZIONE",
     "chain": [
      "Movim_Prenotati",
      "End_Reset",
      {
       "fb": "TON",
       "inst": "Tim_Prenotati",
       "p": {
        "PT": "T#400ms"
       }
      }
     ]
    },
    {
     "cmt": "MOV1 ASSE X SOPRA LA PRESA",
     "chain": [
      "Tim_Prenotati.Q",
      {
       "fb": "MC_MoveAbsolute",
       "inst": "MOV1",
       "p": {
        "Axis": "MC_X",
        "Position": "Distance1",
        "Velocity": "SET_Speed_X",
        "Acceleration": "100",
        "Deceleration": "100",
        "OUT:Axis": "MC_X"
       }
      },
      "(MOV1_Done)"
     ]
    },
    {
     "cmt": "MOV2 ASSE Y DISCESA SU PRESA",
     "chain": [
      "MOV1_Done",
      {
       "fb": "MC_MoveAbsolute",
       "inst": "MOV2",
       "p": {
        "Axis": "MC_Y",
        "Position": "Distance2",
        "Velocity": "SET_Speed_Y",
        "Acceleration": "100",
        "Deceleration": "100",
        "OUT:Axis": "MC_Y"
       }
      },
      "(MOV2_Done)"
     ]
    },
    {
     "cmt": "CHIUSURA PINZA SUL PEZZO",
     "chain": [
      "MOV2_Done",
      {
       "fb": "TON",
       "inst": "Tim_Pinza",
       "p": {
        "PT": "T#1s"
       }
      }
     ]
    },
    {
     "cmt": "",
     "chain": [
      "MOV2_Done",
      "(S OUT_PINZA)"
     ]
    },
    {
     "cmt": "MOV3 ASSE Y SALITA CON PEZZO",
     "chain": [
      "Tim_Pinza.Q",
      {
       "fb": "MC_MoveAbsolute",
       "inst": "MOV3",
       "p": {
        "Axis": "MC_Y",
        "Position": "Distance3",
        "Velocity": "SET_Speed_Y",
        "Acceleration": "100",
        "Deceleration": "100",
        "OUT:Axis": "MC_Y"
       }
      },
      "(MOV3_Done)"
     ]
    },
    {
     "cmt": "MOV4 ASSE X VERSO DEPOSITO",
     "chain": [
      "MOV3_Done",
      {
       "fb": "MC_MoveAbsolute",
       "inst": "MOV4",
       "p": {
        "Axis": "MC_X",
        "Position": "Distance4",
        "Velocity": "SET_Speed_X",
        "Acceleration": "100",
        "Deceleration": "100",
        "OUT:Axis": "MC_X"
       }
      },
      "(MOV4_Done)"
     ]
    },
    {
     "cmt": "MOV5 DISCESA DEPOSITO VELOCE",
     "chain": [
      "MOV4_Done",
      {
       "fb": "MC_MoveAbsolute",
       "inst": "MOV5",
       "p": {
        "Axis": "MC_Y",
        "Position": "Distance5",
        "Velocity": "SET_Speed_Y",
        "Acceleration": "100",
        "Deceleration": "100",
        "OUT:Axis": "MC_Y"
       }
      },
      "(MOV5_Done)"
     ]
    },
    {
     "cmt": "MOV5A AVVICINAMENTO LENTO IN BLENDING",
     "chain": [
      "MOV4_Done",
      {
       "fb": "MC_MoveAbsolute",
       "inst": "MOV5A",
       "p": {
        "Axis": "MC_Y",
        "Position": "Distance5A",
        "Velocity": "LREAL#20",
        "Acceleration": "100",
        "Deceleration": "100",
        "BufferMode": "_eMC_BUFFER_MODE#_mcBlendingPrevious",
        "OUT:Axis": "MC_Y"
       }
      },
      "(MOV5A_Done)"
     ]
    },
    {
     "cmt": "APERTURA PINZA E RILASCIO",
     "chain": [
      "MOV5A_Done",
      {
       "fb": "TON",
       "inst": "Tim_Rilascio",
       "p": {
        "PT": "T#1s"
       }
      }
     ]
    },
    {
     "cmt": "",
     "chain": [
      "MOV5A_Done",
      "(R OUT_PINZA)"
     ]
    },
    {
     "cmt": "MOV6 ASSE Y SALITA DOPO DEPOSITO",
     "chain": [
