 "sections": {
  "Marcia": {
   "rungs": [
    {
     "cmt": "GIRO IL BIT DI MARCIA",
     "chain": [
      "/IN_MARCIA",
      "(Marcia_ON)"
     ]
    },
    {
     "cmt": "RITARDO ABILITAZIONE SERVO",
     "chain": [
      "Marcia_ON",
      {
       "fb": "TON",
       "inst": "Tim_Marcia",
       "p": {
        "PT": "T#3s"
       }
      }
     ]
    },
    {
     "cmt": "ABILITAZIONE SERVO ASSE X",
     "chain": [
      {
       "or": [
        "MC_X.DrvStatus.Ready",
        "MC_X.DrvStatus.ServoOn"
       ]
      },
      "Tim_Marcia.Q",
      {
       "fb": "MC_Power",
       "inst": "Power_X",
       "p": {
        "Axis": "MC_X",
        "OUT:Axis": "MC_X"
       }
      }
     ]
    },
    {
     "cmt": "ABILITAZIONE SERVO ASSE Y",
     "chain": [
      {
       "or": [
        "MC_Y.DrvStatus.Ready",
        "MC_Y.DrvStatus.ServoOn"
       ]
      },
      "Tim_Marcia.Q",
      {
       "fb": "MC_Power",
       "inst": "Power_Y",
       "p": {
        "Axis": "MC_Y",
        "OUT:Axis": "MC_Y"
       }
      }
     ]
    },
    {
     "cmt": "ROBOT READY",
     "chain": [
      "MC_X.Status.Ready",
      "MC_Y.Status.Ready",
      "/MC_X.MFaultLvl.Active",
      "/MC_Y.MFaultLvl.Active",
      "(Robot_Ready)"
     ]
    }
   ],
   "variables": [
