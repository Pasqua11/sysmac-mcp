  "Allarmi": {
   "rungs": [
    {
     "cmt": "Accendo la spia Allarmi del visualizzatore se ho un bit Allarmi Attivo",
     "chain": [
      {
       "f": "ArySearch",
       "p": {
        "In": "Allarme_Bit[1]",
        "Size": "uint#10",
        "Key": "bool#1",
        "InOutPos": "local1",
        "OUT:": "Spia_Allarme",
        "OUT:InOutPos": "local1"
       }
      },
      "Spia_Allarme",
      {
       "f": "Get1sClk",
       "p": {}
      }
     ],
     "out": [
      "(V_L_Allarmi)",
      "(OUT_LAMP)"
     ]
    },
    {
     "cmt": "ALLARME 1: EMERGENZA PREMUTA",
     "chain": [
      "IN_EMERGENZA",
      "(Allarme_Bit[1])"
     ]
    },
    {
     "cmt": "ALLARME 2: INVERTER NO READY",
     "chain": [
      "/IN_INVERTER_READY",
      "/Allarme_Bit[4]",
      {
       "fb": "TON",
       "inst": "Tim3",
       "p": {
        "PT": "T#2s"
       }
      },
      "(Allarme_Bit[2])"
     ]
    },
    {
     "cmt": "ALLARME 3: LIVELLO POMPA",
     "chain": [
      "/Tim_Liv_Pompa_OK.Q",
      "(Allarme_Bit[3])"
     ]
    },
    {
     "cmt": "ALLARME 4: MARCIA ASPIRATORE OFF",
     "chain": [
      "/IN_RELE_SICUREZZA",
      "(Allarme_Bit[4])"
     ]
    },
    {
     "cmt": "ALLARME 5: INVERTER IN MANUALE",
     "chain": [
      "P_Off",
      "(Allarme_Bit[5])"
     ]
    },
    {
     "cmt": "ALLARME 6: ERRORE CONNESSIONE ETHERNET INVERTER",
     "chain": [
      "P_Off",
      "(Allarme_Bit[6])"
     ]
    },
    {
     "cmt": "ALLARME 7: FAULT INVERTER",
     "chain": [
      "P_Off",
      "(Allarme_Bit[7])"
     ]
    },
    {
     "cmt": "ALLARME 8: TERMICO POMPA",
     "chain": [
      "IN_TERMICO_POMPA",
      "(Allarme_Bit[8])"
     ]
    }
   ],
