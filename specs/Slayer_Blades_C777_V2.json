{
 "progetto": "Slayer_Blades_C777_V2",
 "guid": "4d2ce61e-9790-404d-b44b-022daa3fd208",
 "sections": {
  "Aspiratore": {
   "rungs": [
    {
     "cmt": "#MARCIA ASPIRATORE:ATTIVO IL RELè DI SICUREZZA PER LA MARCIA ASPIRATORE",
     "chain": [
      "P_On"
     ],
     "out": [
      [
       "^V_P_Marcia_Aspira",
       "(S Mem_Marcia_Aspiratore)"
      ],
      [
       "IN_RELE_SICUREZZA",
       "(V_L_Marcia_Aspira)"
      ]
     ]
    },
    {
     "cmt": "",
     "chain": [
      {
       "or": [
        "OUT_ARRESTO_ASPIRATORE",
        "IN_EMERGENZA",
        "Mem_Arresto_Aspiratore"
       ]
      },
      "(R Mem_Marcia_Aspiratore)"
     ]
    },
    {
     "cmt": "TIMER DISATTIVAZIONE DELLA MEMORIA DI MARCIA ASPIRATORE",
     "chain": [
      "Mem_Marcia_Aspiratore",
      {
       "fb": "TON",
       "inst": "Tim1",
       "p": {
        "PT": "T#1s"
       }
      }
     ]
    },
    {
     "cmt": "OUTPUT MARCIA ASPIRATORE",
     "chain": [
      "Mem_Marcia_Aspiratore",
      "/Tim1.Q",
      "(OUT_MARCIA_ASPIRATORE)"
     ]
    },
    {
     "cmt": "DOPO 1 SECONDO CHE HO IL RELè DI SICUREZZA ATTIVO AVVIO L'INVERTER",
     "chain": [
      "/IN_EMERGENZA",
      "IN_RELE_SICUREZZA",
      "IN_INVERTER_READY",
      {
       "fb": "TON",
       "inst": "Tim2",
       "p": {
        "PT": "T#1s"
       }
      },
      "/Mem_Arresto_Aspiratore",
      "/Speed_0_Orologio",
      "(OUT_START_INVERTER)"
     ]
    },
    {
     "cmt": "VELOCITà ASPIRATORE",
     "chain": [
      "P_On",
      {
       "or": [
        [
         "/V_P_Orologio",
         {
          "f": "MOVE",
          "p": {
           "In": "SET_Speed_Manu_Inverter",
           "OUT:Out": "OUT_FreqSetpoint"
          }
         },
         {
          "f": "MOVE",
          "p": {
           "In": "SET_Speed_Manu_Inverter",
           "OUT:Out": "PV_Set_Speed_Inverter"
          }
         }
        ],
        [
         "V_P_Orologio",
         {
          "or": [
           [
            {
             "f": "<=",
             "p": {
              "In1": "SET_Speed_Auto_Inverter",
              "In2": "int#50"
             }
            },
            {
             "f": "MUL",
             "p": {
              "In1": "SET_Speed_Auto_Inverter",
              "In2": "int#10",
              "OUT:": "MUL_SET_Speed_Auto_Inverter"
             }
            },
            {
             "f": "MOVE",
             "p": {
              "In": "MUL_SET_Speed_Auto_Inverter",
              "OUT:Out": "OUT_FreqSetpoint"
             }
            },
            {
             "f": "MOVE",
             "p": {
              "In": "MUL_SET_Speed_Auto_Inverter",
              "OUT:Out": "PV_Set_Speed_Inverter"
             }
            }
           ],
           [
            {
             "f": "=",
             "p": {
              "In1": "SET_Speed_Auto_Inverter",
              "In2": "0"
             }
            },
            "(Speed_0_Orologio)"
           ]
          ]
         }
        ]
       ]
      }
     ]
    },
    {
     "cmt": "",
     "chain": [
      "P_On"
     ],
     "out": [
      [
       {
        "f": "<=",
        "p": {
         "In1": "SET_Speed_Auto_Inverter",
         "In2": "0"
        }
       },
       {
        "f": "MOVE",
        "p": {
         "In": "0",
         "OUT:Out": "SET_Speed_Auto_Inverter"
        }
       }
      ],
      [
       {
        "f": "<=",
        "p": {
         "In1": "SET_Speed_Manu_Inverter",
         "In2": "0"
        }
       },
       {
        "f": "MOVE",
        "p": {
         "In": "0",
         "OUT:Out": "SET_Speed_Manu_Inverter"
        }
       }
      ]
     ]
    },
    {
     "cmt": "TRASFORMO IL VALORE 0-500(0-50HZ) IN 0-4000 PER L'USCITA ANALOGICA",
     "chain": [
      "P_On",
      {
       "f": "INT_TO_REAL",
       "p": {
        "In": "OUT_FreqSetpoint",
        "OUT:": "OUT_Analog_FreqSetpoint"
       }
      },
      {
       "f": "ScaleTrans",
       "p": {
        "SclIn": "OUT_Analog_FreqSetpoint",
        "X0": "real#0",
        "Y0": "real#0",
        "X1": "real#500",
        "Y1": "real#3960",
        "OUT:": "OUT_Analog_Scale_FreqSetpoint"
       }
      },
      {
       "f": "REAL_TO_INT",
       "p": {
        "In": "OUT_Analog_Scale_FreqSetpoint",
        "OUT:": "OUT_ANALOG_1"
       }
      }
     ]
    },
    {
     "cmt": "#ARRESTO ASPIRATORE",
     "chain": [
      "P_On"
     ],
     "out": [
      [
       "^V_P_Arresto_Aspira",
       "(S Mem_Arresto_Aspiratore)"
      ],
      [
       "Mem_Arresto_Aspiratore",
       {
        "f": "Get1sClk",
        "p": {}
       },
       "(V_L_Arresto_Aspira)"
      ]
     ]
    },
    {
     "cmt": "",
     "chain": [
      {
       "or": [
        "IN_EMERGENZA",
        "/IN_RELE_SICUREZZA"
       ]
      },
      "(R Mem_Arresto_Aspiratore)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      "Mem_Arresto_Aspiratore",
      "/Inverter_STS.DriveRunning",
      {
       "f": "<=",
       "p": {
        "In1": "PV_Inverter_Speed",
        "In2": "int#1"
       }
      },
      "(OUT_ARRESTO_ASPIRATORE)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      "_EIP1_EstbTargetSta[3]",
      "(Ethernet_Inverter_OK)"
     ]
    },
    {
     "cmt": "TRASFORMO L'INGRESSO ANALOGICO 1 IN UNA FREQUENZA 0-500 (0-50hZ)",
     "chain": [
      "P_On",
      {
       "f": "INT_TO_REAL",
       "p": {
        "In": "IN_ANALOG_1",
        "OUT:": "IN_ANALOG_1_REAL"
       }
      },
      {
       "f": "ScaleTrans",
       "p": {
        "SclIn": "IN_ANALOG_1_REAL",
        "X0": "real#0",
        "Y0": "real#0",
        "X1": "real#4004",
        "Y1": "real#500",
        "OUT:": "IN_ANALOG_1_REAL_Scale"
       }
      },
      {
       "f": "REAL_TO_INT",
       "p": {
        "In": "IN_ANALOG_1_REAL_Scale",
        "OUT:": "PV_Inverter_Speed"
       }
      },
      {
       "f": ">",
       "p": {
        "In1": "PV_Inverter_Speed",
        "In2": "INT#0"
       }
      },
      "(PV_Inverter_Enable)"
     ]
    },
    {
     "cmt": "TRASFORMO L'INGRESSO ANALOGICO 2 IN UN VALORE DI ASSORBIMENTO IN AMPERE",
     "chain": [
      "P_On",
      {
       "f": "INT_TO_REAL",
       "p": {
        "In": "IN_ANALOG_2",
        "OUT:": "IN_ANALOG_2_REAL"
       }
      },
      {
       "f": "ScaleTrans",
       "p": {
        "SclIn": "IN_ANALOG_2_REAL",
        "X0": "real#0",
        "Y0": "real#0",
        "X1": "real#4000",
        "Y1": "real#360",
        "OUT:": "IN_ANALOG_2_REAL_Scale"
       }
      },
      {
       "f": "REAL_TO_INT",
       "p": {
        "In": "IN_ANALOG_2_REAL_Scale",
        "OUT:": "PV_Inverter_Current"
       }
      }
     ]
    },
    {
     "cmt": "CONTEGGIO ORE DI FUNZIONAMENTO ASPIRATORE",
     "chain": [
      "OUT_START_INVERTER",
      "^Clock_1Min",
      {
       "f": "@Inc",
       "p": {
        "InOut": "PV_Contaore",
        "OUT:InOut": "PV_Contaore"
       }
      }
     ]
    },
    {
     "cmt": "",
     "chain": [
      {
       "f": "Get1minClk",
       "p": {}
      },
      "(Clock_1Min)"
     ]
    }
   ],
