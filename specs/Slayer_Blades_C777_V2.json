  "Pompa": {
   "rungs": [
    {
     "cmt": "LIVELLO POMPA OK",
     "chain": [
      "IN_LIV_POMPA",
      {
       "fb": "TON",
       "inst": "Tim_Liv_Pompa_OK",
       "p": {
        "PT": "TIME#2S"
       }
      }
     ]
    },
    {
     "cmt": "#MARCIA POMPA:ATTIVO LA POMPA",
     "chain": [
      "P_On"
     ],
     "out": [
      [
       "^V_P_Marcia_Pompa",
       "(S Mem_Marcia_Pompa)"
      ],
      [
       "Mem_Marcia_Pompa",
       "(V_L_Marcia_Pompa)"
      ]
     ]
    },
    {
     "cmt": "ARRESTO POMPA",
     "chain": [
      "P_On",
      {
       "or": [
        "^V_P_Arresto_Pompa",
        "IN_EMERGENZA",
        "IN_TERMICO_POMPA"
       ]
      },
      "(R Mem_Marcia_Pompa)"
     ]
    },
    {
     "cmt": "USCITA POMPA",
     "chain": [
      "Mem_Marcia_Pompa",
      "Tim_Liv_Pompa_OK.Q",
      {
       "or": [
        "/V_P_Orologio",
        [
         "V_P_Orologio",
         {
          "f": ">",
          "p": {
           "In1": "SET_Speed_Auto_Inverter",
           "In2": "0"
          }
         }
        ]
       ]
      },
      "(OUT_MARCIA_POMPA)"
     ]
    },
    {
     "cmt": "REINTEGRO ACQUA",
     "chain": [
      "P_On"
     ],
     "out": [
      [
       "/IN_LIV_MIN",
       "(S Mem_Riempimento)"
      ],
      [
       "IN_LIV_MAX",
       "(R Mem_Riempimento)"
      ]
     ]
    },
    {
     "cmt": "USCITE",
     "chain": [
      "/IN_EMERGENZA",
      {
       "or": [
        "V_P_Manu_Valve_1",
        "Mem_Riempimento"
       ]
      },
      "(OUT_EV_1)"
     ]
    },
    {
     "cmt": "CONTEGGIO ORE DI FUNZIONAMENTO POMPA",
     "chain": [
      "OUT_MARCIA_POMPA",
      "^Clock_1Min",
      {
       "f": "@Inc",
       "p": {
        "InOut": "PV_Contaore_Pompa",
        "OUT:InOut": "PV_Contaore_Pompa"
       }
      }
     ]
    }
   ],
