  "Sezione0": {
   "rungs": [
    {
     "cmt": "GIRO IL BIT DI MARCIA",
     "chain": [
      "/IN_MARCIA",
      "(Marcia_ON)"
     ]
    },
    {
     "cmt": "RITARDO ABILITAZIONE SERVO",
     "chain": [
      "Marcia_ON",
      {
       "fb": "TON",
       "inst": "Tim_Marcia",
       "p": {
        "PT": "T#3s"
       }
      }
     ]
    },
    {
     "cmt": "ABILITAZIONE SERVO ASSE X",
     "chain": [
      "Tim_Marcia.Q",
      "mc_x.DrvStatus.Ready",
      "mc_x.DrvStatus.MainPower",
      {
       "fb": "MC_Power",
       "inst": "Power_x",
       "p": {
        "Axis": "mc_x",
        "OUT:Axis": "mc_x"
       }
      }
     ]
    },
    {
     "cmt": "ABILITAZIONE SERVO ASSE Y",
     "chain": [
      "Tim_Marcia.Q",
      "mc_y.DrvStatus.Ready",
      "mc_y.DrvStatus.MainPower",
      {
       "fb": "MC_Power",
       "inst": "Power_y",
       "p": {
        "Axis": "mc_y",
        "OUT:Axis": "mc_y"
       }
      }
     ]
    },
    {
     "cmt": "RITARDO ABILITAZIONE GRUPPO ASSI",
     "chain": [
      "End_Reset_Robot",
      {
       "fb": "TON",
       "inst": "Tim3",
       "p": {
        "PT": "T#2s"
       }
      }
     ]
    },
    {
     "cmt": "CONSENSO GRUPPO ASSI",
     "chain": [
      "Tim3.Q",
      "(GruppoEnable)"
     ]
    },
    {
     "cmt": "ABILITAZIONE GRUPPO ASSI PER INTERPOLAZIONI",
     "chain": [
      "GruppoEnable",
      {
       "fb": "MC_GroupEnable",
       "inst": "Group1",
       "p": {
        "AxesGroup": "MC_Group000",
        "OUT:AxesGroup": "MC_Group000"
       }
      }
     ]
    },
    {
     "cmt": "DISABILITAZIONE GRUPPO ASSI",
     "chain": [
      "/GruppoEnable",
      {
       "fb": "MC_GroupDisable",
       "inst": "Group1_OFF",
       "p": {
        "AxesGroup": "MC_Group000",
        "OUT:AxesGroup": "MC_Group000"
       }
      }
     ]
    },
    {
     "cmt": "RESET ERRORI ASSE X",
     "chain": [
      "IN_RESET",
      {
       "fb": "MC_Reset",
       "inst": "X_Reset_Error",
       "p": {
        "Axis": "mc_x",
        "OUT:Axis": "mc_x"
       }
      }
     ]
    },
    {
     "cmt": "RESET ERRORI GRUPPO ASSI",
     "chain": [
      "IN_RESET",
      {
       "fb": "MC_GroupReset",
       "inst": "Group_Reset_Error",
       "p": {
        "AxesGroup": "MC_Group000",
        "OUT:AxesGroup": "MC_Group000"
       }
      }
     ]
    },
    {
     "cmt": "ARRESTO ASSE X",
     "chain": [
      "/End_Reset_Robot",
      {
       "fb": "MC_Stop",
       "inst": "MC_X_Stop",
       "p": {
        "Axis": "mc_x",
        "Deceleration": "200",
        "OUT:Axis": "mc_x"
       }
      }
     ]
    },
    {
     "cmt": "ROBOT READY",
     "chain": [
      "mc_x.DrvStatus.ServoOn",
      "mc_y.DrvStatus.ServoOn",
      "/mc_x.MFaultLvl.Active",
      "/mc_y.MFaultLvl.Active",
      "(Robot_Ready)"
     ]
    },
    {
     "cmt": "MANUALE ASSE X",
     "chain": [
      "Robot_Ready",
      "X_Jog_SX",
      {
       "fb": "MC_MoveJog",
       "inst": "Manu_X",
       "p": {
        "Axis": "mc_x",
        "NegativeEnable": "X_Jog_DX",
        "Velocity": "40",
        "Acceleration": "15",
        "Deceleration": "100000",
        "OUT:Axis": "mc_x"
       }
      }
     ]
    },
    {
     "cmt": "CALCOLO QUOTE MOVIMENTAZIONE",
     "chain": [
      "P_On",
      {
       "ist": "Distance1[0]:=X_PRESA+X_AGGANCIO;\r\nDistance1[1]:=0;"
      }
     ]
    },
    {
     "cmt": "MOV1 - TRASLAZIONE INTERPOLATA SOPRA LA PRESA",
     "chain": [
      "Movim_Prenotati",
      {
       "fb": "MC_MoveLinearAbsolute",
       "inst": "MOV1",
       "p": {
        "AxesGroup": "MC_Group000",
        "Position": "Distance1",
        "Velocity": "300",
        "Acceleration": "500",
        "Deceleration": "500",
        "OUT:AxesGroup": "MC_Group000"
       }
      }
     ]
    },
    {
     "cmt": "1) DUE USCITE: ABILITAZIONE SERVO X E Y NELLO STESSO RUNG",
     "chain": [
      "Tim_Marcia.Q",
      "mc_x.DrvStatus.Ready",
      "mc_y.DrvStatus.Ready"
     ],
     "out": [
      {
       "fb": "MC_Power",
       "inst": "Power_x",
       "p": {
        "Axis": "mc_x",
        "OUT:Axis": "mc_x"
       }
      },
      {
       "fb": "MC_Power",
       "inst": "Power_y",
       "p": {
        "Axis": "mc_y",
        "OUT:Axis": "mc_y"
       }
      }
     ]
    },
    {
     "cmt": "2bis) STESSO RUNG CON ALTEZZA CALCOLATA",
     "chain": [
      {
       "or": [
        "IN_RESET",
        [
         "Reset_Auto_All_Robot",
         {
          "f": "Get100msClk",
          "p": {}
         }
        ]
       ]
      }
     ],
     "out": [
      {
       "fb": "MC_Reset",
       "inst": "X_Reset_Error",
       "p": {
        "Axis": "mc_x",
        "OUT:Axis": "mc_x"
       }
      },
      {
       "fb": "MC_Reset",
       "inst": "Y_Reset_Error",
       "p": {
        "Axis": "mc_y",
        "OUT:Axis": "mc_y"
       }
      },
      {
       "fb": "MC_GroupReset",
       "inst": "Group_Reset_Error",
       "p": {
        "AxesGroup": "MC_Group000",
        "OUT:AxesGroup": "MC_Group000"
       }
      }
     ]
    },
    {
     "cmt": "3) OR A 12 RAMI: MOVIMENTAZIONE PRENOTATA",
     "chain": [
      {
       "or": [
        "Car_V1",
        "Car_V3",
        "V1_V2",
        "V2_V3",
        "V3_V4",
        "V4_V5",
        "V5_V6",
        "V6_V7",
        "V7_F1",
        "V7_F2",
        "F1_Scar",
        "F2_Scar"
       ]
      },
      "(Movim_Prenotati)"
     ]
    },
    {
     "cmt": "4) OR IN MEZZO ALLA CATENA + DUE BOBINE",
     "chain": [
      "Robot_Ready",
      {
       "or": [
        "Look1",
        "Look2"
       ]
      },
      "/IN_MARCIA"
     ],
     "out": [
      "(Blocco_Portellino)",
      "(Spia_Blocco)"
     ]
    },
    {
     "cmt": "2bis) STESSO RUNG CON ALTEZZA CALCOLATA",
     "chain": [
      {
       "or": [
        "IN_RESET",
        [
         "Reset_Auto_All_Robot",
         {
          "f": "Get100msClk",
          "p": {}
         }
        ]
       ]
      }
     ],
     "out": [
      {
       "fb": "MC_Reset",
       "inst": "X_Reset_Error",
       "p": {
        "Axis": "mc_x",
        "OUT:Axis": "mc_x"
       }
      },
      {
       "fb": "MC_Reset",
       "inst": "Y_Reset_Error",
       "p": {
        "Axis": "mc_y",
        "OUT:Axis": "mc_y"
       }
      },
      {
       "fb": "MC_GroupReset",
       "inst": "Group_Reset_Error",
       "p": {
        "AxesGroup": "MC_Group000",
        "OUT:AxesGroup": "MC_Group000"
       }
      }
     ]
    },
    {
     "cmt": "TEST TOF (tipi concreti)",
     "chain": [
      "IN_MARCIA",
      {
       "fb": "TOF",
       "inst": "Ist_Rit_Reset_EC_Error",
       "p": {
        "PT": "T#5s"
       }
      },
      "(Eseguito)"
     ]
    },
    {
     "cmt": "[ADDITIONAL_HOOD / Vasca2_QDR] #QDR: SE NEI SETTAGGI HO IMPOSTATO UNA QDR ATTIVO LA SEQUENZA",
     "chain": [
      "Mem_Ciclo_V2"
     ],
     "out": [
      [
       {
        "f": ">",
        "p": {
         "In1": "SET_QDR_V2",
         "In2": "0"
        }
       },
       "(QDR_V2_Enable)"
      ],
      {
       "f": "@MOVE",
       "p": {
        "In": "0",
        "OUT:Out": "PV_QDR_V2"
       }
      }
     ]
    },
    {
     "cmt": "5) OR CON RITENUTA (MARCIA/ARRESTO CLASSICO)",
     "chain": [
      {
       "or": [
        "^IN_RESET",
        "Mem_Start"
       ]
      },
      "/IN_MARCIA",
      "(Mem_Start)"
     ]
    }
   ],
