     "cmt": "CALCOLO QUOTE PER MOVIMENTAZIONE",
     "chain": [
      "P_On",
      {
       "ist": "(*Quote robot movimentazione da PRESA a DEPOSITO*) \r\n(*MOV1 asse X*) \r\nDistance1[0]:=(X_PRESA - 50); \r\nDistance1[1]:=0; \r\n(*MOV2 asse Y giÃ¹*) \r\nDistance2[0]:=(Distance1[0]); \r\nDistance2[1]:=(Y_PRESA); \r\n(*MOV3 asse X aggancio*) \r\nDistance3[0]:=(X_PRESA ); \r\nDistance3[1]:=Distance2[1]; \r\n(*MOV4A asse Y aggancio *) \r\nDistance4_Acc[0]:=0; \r\nDistance4_Acc[1]:=-50;(*mm di velocitÃ  bassa) \r\n(*MOV4 asse Y salita con cesto*) \r\nDistance4[0]:=Distance3[0]; \r\nDistance4[1]:=0; \r\n(*MOV5 asse X con cesto*) \r\nDistance5[0]:=(X_DEPOSITO ); \r\nDistance5[1]:=Distance4[1]; \r\n(*MOV6 asse Y deposito cesto*) \r\nDistance6[0]:=(Distance5[0]); \r\nDistance6[1]:=(Y_DEPOSITO-50); \r\n(*MOV6A asse Y deposito cesto velocitÃ  bassa*) \r\nDistance6_Dec[0]:=(Distance5[0]); \r\nDistance6_Dec[1]:=(Y_DEPOSITO); \r\n(*MOV7*) \r\nDistance7[0]:=(X_DEPOSITO -50); \r\nDistance7[1]:=Distance6_Dec[1]; \r\n(*MOV8*) \r\nDistance8[0]:=(Distance7[0] ); \r\nDistance8[1]:=0; \r\n \r\n;"
      }
     ]
    },
    {
