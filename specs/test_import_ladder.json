  "Sezione1": {
   "rungs": [
    {
     "cmt": "",
     "_NON_CONVERTITO": "rung vuoto"
    },
    {
     "cmt": "PORTELLI  CHUSURA ",
     "chain": [
      {
       "or": [
        "Mem_Puls_Marcia",
        [
         "Marcia_ON",
         "/Apro_Porte"
        ]
       ]
      }
     ],
     "out": [
      "(OUT_PORTELLI)",
      "(/IN_PORTE_APERTE)"
     ]
    },
    {
     "cmt": "PORTELLI  PRENOTO L'APERTURA DEI PORTELLI",
     "chain": [
      "P_On"
     ],
     "out": [
      [
       "Marcia_ON",
       "V_P_Prenoto_Porte",
       {
        "fb": "TON",
        "inst": "Tim26",
        "p": {
         "PT": "TIME#500MS"
        }
       },
       "(S Call_Prenoto_Porte)"
      ],
      [
       "IN_PULS_MARCIA",
       "/IN_PORTE_APERTE",
       "(R Call_Prenoto_Porte)"
      ]
     ]
    },
    {
     "cmt": "ATTIVO L'APERTURA DEI PORTELLI",
     "chain": [
      "Call_Prenoto_Porte",
      "End_Reset_Robot",
      "/Movim_Prenotati",
      {
       "fb": "TON",
       "inst": "Tim27",
       "p": {
        "PT": "TIME#1S"
       }
      },
      "/OUT_AGITAZIONE",
      "/OUT_NASTRO_CARICO",
      "/OUT_NASTRO_SCARICO",
      {
       "fb": "TON",
       "inst": "Tim28",
       "p": {
        "PT": "TIME#1S"
       }
      },
      "(Apro_Porte)"
     ]
    },
    {
     "cmt": "MEMORIZZO CHE HO ESEGUITO UN APERTURA PORTELLI COMANDATA DA VISUALIZZATORE",
     "chain": [
      "P_On"
     ],
     "out": [
      [
       "Call_Prenoto_Porte",
       "Apro_Porte",
       "(S Mem_Portelle_Open)"
      ],
      [
       "Marcia_ON",
       "(R Mem_Portelle_Open)"
      ]
     ]
    },
    {
     "cmt": "DOPO UNA CHIUSURA PORTELLI RESETTO GLI ALLARMI DEL ROBOT IN AUTOMATICO",
     "chain": [
      "P_On",
      {
       "or": [
        "vMem_Portelle_Open",
        "Robot_Ready",
        "IN_RESET"
       ]
      }
     ],
     "out": [
      "(S Reset_Auto_All_Robot)",
      "(R Reset_Auto_All_Robot)"
     ]
    },
    {
     "cmt": "LAMP PRENOTAZIONE PORTELLI",
     "chain": [
      {
       "or": [
        "Apro_Porte",
        [
         "Call_Prenoto_Porte",
         {
          "f": "Get1sClk",
          "p": {}
         }
        ]
       ]
      },
      "(V_L_Prenoto_Porte)"
     ]
    },
    {
     "cmt": "MEMORIZZO CHE HO ESEGUITO UN APERTURA PORTELLI.MI SERVE DURANTE LA RIPARTENZA DELLA MOVIMENTAZIONE PER EVITARE UNA  DISCESA BRUSCA DELL'ASSE Y DURANTE IL MOV 2.QUINDI METTO UNA PAUSA TRA MOV1 E MOV 2 ",
     "chain": [
      "P_On"
     ],
     "out": [
      [
       "vMem_Portelle_Open",
       "(S Pausa_Mov1_2)"
      ],
      [
       "MOV3_Done",
       "(R Pausa_Mov1_2)"
      ]
     ]
    }
   ],
