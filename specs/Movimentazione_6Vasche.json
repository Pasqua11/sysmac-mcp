     "(S Mem_V4)"
    ]
   },
   {
    "cmt": "TEMPO DI PERMANENZA VASCA 4",
    "chain": [
     "Mem_V4",
     {
      "fb": "TON",
      "inst": "Tim_V4",
      "p": {
       "PT": "SET_Tempo_V4"
      }
     },
     "(End_V4)"
    ]
   },
   {
    "cmt": "USCITA VASCA 4",
    "chain": [
     "End_V4",
     "(R Mem_V4)"
    ]
   },
   {
    "cmt": "INGRESSO VASCA 5",
    "chain": [
     "P_On",
     "Mem_Ciclo",
     "Mem_Pieno",
     "IN_POS_V5",
     "IN_CARRO_BASSO",
     "End_V4",
     "/End_V5",
     "(S Mem_V5)"
    ]
   },
   {
    "cmt": "TEMPO DI PERMANENZA VASCA 5",
    "chain": [
     "Mem_V5",
     {
      "fb": "TON",
      "inst": "Tim_V5",
      "p": {
       "PT": "SET_Tempo_V5"
      }
     },
     "(End_V5)"
    ]
   },
   {
    "cmt": "USCITA VASCA 5",
    "chain": [
     "End_V5",
     "(R Mem_V5)"
    ]
   },
   {
    "cmt": "INGRESSO VASCA 6",
    "chain": [
     "P_On",
     "Mem_Ciclo",
     "Mem_Pieno",
     "IN_POS_V6",
     "IN_CARRO_BASSO",
     "End_V5",
     "/End_V6",
     "(S Mem_V6)"
    ]
   },
   {
    "cmt": "TEMPO DI PERMANENZA VASCA 6",
    "chain": [
     "Mem_V6",
     {
      "fb": "TON",
      "inst": "Tim_V6",
      "p": {
       "PT": "SET_Tempo_V6"
      }
     },
     "(End_V6)"
    ]
   },
   {
    "cmt": "USCITA VASCA 6",
    "chain": [
     "End_V6",
     "(R Mem_V6)"
    ]
   },
   {
    "cmt": "DEPOSITO ALLO SCARICO",
    "chain": [
     "P_On",
     "Mem_Ciclo",
     "End_V6",
     "IN_POS_SCARICO",
     "IN_CARRO_BASSO",
     "Mem_Pieno",
     "(S Mem_Scarico)"
    ]
   },
   {
    "cmt": "PEZZO DEPOSITATO",
    "chain": [
     "Mem_Scarico",
     "IN_CARRO_ALTO",
     "(R Mem_Pieno)"
    ]
   },
   {
    "cmt": "FINE PASSO DI SCARICO",
    "chain": [
     "Mem_Scarico",
     "/Mem_Pieno",
     "(R Mem_Scarico)"
    ]
   },
   {
    "cmt": "CICLO COMPLETATO",
    "chain": [
     "Mem_Ciclo",
     "End_V6",
     "/Mem_Pieno",
     "/Mem_Scarico",
     "(S Mem_Fine_Ciclo)"
    ]
   },
   {
    "cmt": "RIPRISTINO FINE CICLO",
    "chain": [
     {
      "or": [
       "V_P_Start_Ciclo",
       "V_P_Annulla"
      ]
     },
     "(R Mem_Fine_Ciclo)"
    ]
   },
   {
    "cmt": "TRASLAZIONE AVANTI",
    "chain": [
     "Enable_Ciclo",
     "Mem_Ciclo",
     "Mem_Pieno",
     "IN_CARRO_ALTO",
     "/IN_POS_SCARICO",
     "(OUT_CARRO_AVANTI)"
    ]
   },
   {
    "cmt": "TRASLAZIONE INDIETRO",
    "chain": [
     "Enable_Ciclo",
     "Mem_Ciclo",
     "/Mem_Pieno",
     "IN_CARRO_ALTO",
     "/IN_POS_CARICO",
     "(OUT_CARRO_INDIETRO)"
    ]
   },
   {
    "cmt": "SOLLEVAMENTO CESTELLO",
    "chain": [
     {
      "or": [
       "Mem_Carico",
       "Mem_Scarico"
      ]
     },
     "Enable_Ciclo",
     "/IN_CARRO_ALTO",
     "(OUT_SOLLEVA)"
    ]
   },
   {
    "cmt": "ABBASSAMENTO CESTELLO",
    "chain": [
     {
      "or": [
       "Mem_V1",
       "Mem_V2",
       "Mem_V3",
       "Mem_V4",
       "Mem_V5",
       "Mem_V6"
      ]
     },
     "Enable_Ciclo",
     "/IN_CARRO_BASSO",
     "(OUT_ABBASSA)"
    ]
   },
   {
    "cmt": "SPIA CICLO ATTIVO",
    "chain": [
     "Mem_Ciclo",
     "(V_L_Ciclo_Attivo)"
    ]
   },
   {
    "cmt": "SPIA CARRO CARICO",
    "chain": [
     "Mem_Pieno",
     "(V_L_Carro_Carico)"
    ]
   },
   {
    "cmt": "SPIA ALLARME CUMULATIVO",
    "chain": [
     {
      "or": [
       "Allarme_Bit[1]",
       "Allarme_Bit[2]",
       "Allarme_Bit[3]"
      ]
     },
     "(V_L_Allarme)"
    ]
   },
   {
    "cmt": "ALLARME 1: EMERGENZA PREMUTA",
    "chain": [
     "IN_EMERGENZA",
     "(Allarme_Bit[1])"
    ]
   },
   {
    "cmt": "ALLARME 2: MANCANZA ARIA COMPRESSA",
    "chain": [
     "Mem_Ciclo",
     "/IN_PRESS_ARIA",
     {
      "fb": "TON",
      "inst": "Tim_All_Aria",
      "p": {
       "PT": "T#3s"
      }
     },
     "(Allarme_Bit[2])"
    ]
   },
   {
    "cmt": "ALLARME 3: TEMPO TRASLAZIONE SUPERATO",
    "chain": [
     {
      "or": [
       "OUT_CARRO_AVANTI",
       "OUT_CARRO_INDIETRO"
      ]
     },
     {
      "fb": "TON",
      "inst": "Tim_All_Traslazione",
      "p": {
       "PT": "T#60s"
      }
     },
     "(Allarme_Bit[3])"
    ]
   }
  ]
 }
