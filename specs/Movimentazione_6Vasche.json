 "sections": {
  "Movimentazione": [
   {
    "cmt": "CLOCK 1 SECONDO",
    "chain": [
     "P_On",
     {
      "f": "Get1sClk",
      "p": {}
     },
     "(Clock_1Sec)"
    ]
   },
   {
    "cmt": "CONSENSO GENERALE",
    "chain": [
     "/IN_EMERGENZA",
     "IN_PRESS_ARIA",
     "V_S_Auto",
     "(Enable_Ciclo)"
    ]
   },
   {
    "cmt": "START CICLO",
    "chain": [
     "P_On",
     "V_P_Start_Ciclo",
     "Enable_Ciclo",
     "/Seq_Attiva",
     "(S Mem_Ciclo)"
    ]
   },
   {
    "cmt": "ARRESTO E ANNULLAMENTO CICLO",
    "chain": [
     {
      "or": [
       "V_P_Stop_Ciclo",
       "V_P_Annulla",
       "IN_EMERGENZA",
       "Allarme_Bit[1]",
       "Mem_Fine_Ciclo"
      ]
     },
     "(R Mem_Ciclo)"
    ]
   },
   {
    "cmt": "SEQUENZA ATTIVA",
    "chain": [
     {
      "or": [
       "Mem_Carico",
       "Mem_Scarico",
       "Mem_V1",
       "Mem_V2",
       "Mem_V3",
       "Mem_V4",
       "Mem_V5",
       "Mem_V6"
      ]
     },
     "(Seq_Attiva)"
    ]
   },
   {
    "cmt": "PRELIEVO AL CARICO",
    "chain": [
     "P_On",
     "Mem_Ciclo",
     "IN_POS_CARICO",
     "IN_PRESENZA_PEZZO",
     "/Mem_Pieno",
     "(S Mem_Carico)"
    ]
   },
   {
    "cmt": "PEZZO PRELEVATO",
    "chain": [
     "Mem_Carico",
     "IN_CARRO_ALTO",
     "(S Mem_Pieno)"
    ]
   },
   {
    "cmt": "FINE PASSO DI CARICO",
    "chain": [
     "Mem_Pieno",
     "(R Mem_Carico)"
    ]
   },
   {
    "cmt": "INGRESSO VASCA 1",
    "chain": [
     "P_On",
     "Mem_Ciclo",
     "Mem_Pieno",
     "IN_POS_V1",
     "IN_CARRO_BASSO",
     "Mem_Pieno",
     "/End_V1",
     "(S Mem_V1)"
    ]
   },
   {
    "cmt": "TEMPO DI PERMANENZA VASCA 1",
    "chain": [
     "Mem_V1",
     {
      "fb": "TON",
      "inst": "Tim_V1",
      "p": {
       "PT": "SET_Tempo_V1"
      }
     },
     "(End_V1)"
    ]
   },
   {
    "cmt": "USCITA VASCA 1",
    "chain": [
     "End_V1",
     "(R Mem_V1)"
    ]
   },
   {
    "cmt": "INGRESSO VASCA 2",
    "chain": [
     "P_On",
     "Mem_Ciclo",
     "Mem_Pieno",
     "IN_POS_V2",
     "IN_CARRO_BASSO",
     "End_V1",
     "/End_V2",
     "(S Mem_V2)"
    ]
   },
   {
    "cmt": "TEMPO DI PERMANENZA VASCA 2",
    "chain": [
     "Mem_V2",
     {
      "fb": "TON",
      "inst": "Tim_V2",
      "p": {
       "PT": "SET_Tempo_V2"
      }
     },
     "(End_V2)"
    ]
   },
   {
    "cmt": "USCITA VASCA 2",
    "chain": [
     "End_V2",
     "(R Mem_V2)"
    ]
   },
   {
    "cmt": "INGRESSO VASCA 3",
    "chain": [
     "P_On",
     "Mem_Ciclo",
     "Mem_Pieno",
