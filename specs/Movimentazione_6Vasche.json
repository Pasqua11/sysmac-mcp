     "Mem_V3",
     {
      "fb": "TON",
      "inst": "Tim_V3",
      "p": {
       "PT": "SET_Tempo_V3"
      }
     },
     "(End_V3)"
    ]
   },
   {
    "cmt": "USCITA VASCA 3",
    "chain": [
     "End_V3",
     "(R Mem_V3)"
    ]
   },
   {
    "cmt": "INGRESSO VASCA 4",
    "chain": [
     "P_On",
     "Mem_Ciclo",
     "Mem_Pieno",
     "IN_POS_V4",
     "IN_CARRO_BASSO",
     "End_V3",
