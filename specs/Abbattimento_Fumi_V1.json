    {
     "cmt": "CONRTEGGIO ORE DI FUZIONAMENTO POMPA 1",
     "chain": [
      "PUMP1_Active",
      "^Clock_1Min",
      {
       "f": "@Inc",
       "p": {
        "InOut": "PV_Minuti_PUMP1",
        "OUT:InOut": "PV_Minuti_PUMP1"
       }
      }
     ]
    },
    {
     "cmt": "GESTIONE LOCALE REMOTO SELETTORE POMPA",
