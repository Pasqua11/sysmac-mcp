  "Analogiche": {
   "rungs": [
    {
     "cmt": "SCALO L'INGRESSO ANALOGICO DI LIVELLO  LA SCHEDA HA 2000 PUNTI DI RISOLZIONE  400=4mA  2000=20mA \r\nStrumento di livello utilizzato Banner  taratura impostata tramite suo software 4mA=200mm  20mA=770mm\r\nNei settaggi visu:  Liv.Pompa=220mm   Liv.Minimo=400mm  Liv.Massimo=440mm  Calibrazione _Strumento=770mm\r\n\r\n\r\n\r\n",
     "chain": [
      "P_On",
      {
       "f": "LIMIT",
       "p": {
        "MN": "int#0",
        "In": "ANALOG_IN_1",
        "MX": "int#2000",
        "OUT:": "ANALOG_IN_1_Limit"
       }
      },
      {
       "f": "INT_TO_REAL",
       "p": {
        "In": "ANALOG_IN_1_Limit",
        "OUT:": "PV_Analog1_Real"
       }
      },
      {
       "f": "ScaleTrans",
       "p": {
        "SclIn": "PV_Analog1_Real",
        "X0": "real#400",
        "Y0": "real#200",
        "X1": "real#2000",
        "Y1": "SET_mm_Liv_Pieno",
        "OUT:": "PV_Livello"
       }
      }
     ]
    },
    {
     "cmt": "Complementare per invertire la lettura dei millimetri+ media",
     "chain": [
      "P_On"
     ],
     "out": [
      {
       "f": "-",
       "p": {
        "In1": "SET_mm_Liv_Pieno",
        "In2": "average1",
        "OUT:": "PV_mm_Livello"
       }
      },
      [
       {
        "f": "Get100msClk",
        "p": {}
       },
       {
        "f": "@MovingAverage",
        "p": {
         "In": "PV_Livello",
         "CurIndex": "index1",
         "Buf": "Buffer1[1]",
         "BufSize": "uint#100",
         "Q": "done1",
         "OUT:": "Average1",
         "OUT:CurIndex": "index1",
         "OUT:Buf": "Buffer1[1]",
         "OUT:Q": "done1"
        }
       }
      ]
     ]
    },
    {
     "cmt": "TRASFORMO LA PERCENTUALE DI LIVELLO NEI LIVELLI DA UTILIZZARE NEL PROCESSO",
     "chain": [
      "P_On"
     ],
     "out": [
      [
       {
        "f": ">=",
        "p": {
         "In1": "PV_mm_Livello",
         "In2": "SET_Liv_Minimo"
        }
       },
       {
        "fb": "TON",
        "inst": "Tim_32",
        "p": {
         "PT": "T#2s"
        }
       },
       "(LIV_MIN)"
      ],
      [
       {
        "f": ">=",
        "p": {
         "In1": "PV_mm_Livello",
         "In2": "SET_Liv_Massimo"
        }
       },
       {
        "fb": "TON",
        "inst": "Tim_33",
        "p": {
         "PT": "T#2s"
        }
       },
       "(LIV_MAX)"
      ]
     ]
    },
    {
     "cmt": "ISTERESI PER INTERVENTO LIVELLO POMPA CALCOLO LIVELLO DI RIATTIVAZIONE LIVELLO.IMPOSTATO 5%",
     "chain": [
      {
       "f": "/",
       "p": {
        "In1": "SET_Liv_Pompa",
        "In2": "real#100",
        "OUT:": "Div_Set_Liv_Pompa"
       }
      },
      {
       "f": "*",
       "p": {
        "In1": "Div_Set_Liv_Pompa",
        "In2": "real#105",
        "OUT:": "Liv_Pompa_H"
       }
      }
     ]
    },
    {
     "cmt": "LIVELLO POMPA CON ISTERESI",
     "chain": [
      "P_On"
     ],
     "out": [
      [
       {
        "f": "<",
        "p": {
         "In1": "PV_mm_Livello",
         "In2": "SET_Liv_Pompa"
        }
       },
       "(R LIV_POMPA)"
      ],
      [
       {
        "f": ">",
        "p": {
         "In1": "PV_mm_Livello",
         "In2": "Liv_Pompa_H"
        }
       },
       "(S LIV_POMPA)"
      ]
     ]
    }
   ],
