    },
    {
     "cmt": "SOLUZIONE",
     "chain": [
      "IN_EMERGENZA",
      "Enable_Dosaggio",
      {
       "or": [
        "IN_RELE_PH",
        "V_P_Soluzione"
       ]
      },
      "/OUT_EV_SCARICO",
      "LIV_POMPA",
      "(OUT_EV_SOLUZIONE)"
     ]
    },
    {
     "cmt": "PURGE AUTOMATICO",
     "chain": [
      "OUT_PUMP_1",
      "V_S_Enable_Purge"
     ],
     "out": [
      [
       "^Clock_1Min",
       {
        "f": "<",
        "p": {
         "In1": "PV_Minuti_Purge_OFF",
         "In2": "SET_Time_Purge_OFF"
        }
       },
       {
        "f": "Inc",
        "p": {
         "InOut": "PV_Minuti_Purge_OFF",
         "OUT:InOut": "PV_Minuti_Purge_OFF"
        }
       }
      ],
      [
       {
        "f": ">=",
        "p": {
         "In1": "PV_Minuti_Purge_OFF",
         "In2": "SET_Time_Purge_OFF"
        }
       },
       "^Clock_1Sec",
       {
        "f": "Inc",
        "p": {
         "InOut": "PV_Sec_Purge_ON",
         "OUT:InOut": "PV_Sec_Purge_ON"
        }
       }
      ],
      [
       {
        "f": ">=",
        "p": {
         "In1": "PV_Minuti_Purge_OFF",
         "In2": "SET_Time_Purge_OFF"
        }
       },
       "(Purge_Auto)"
      ],
      [
       {
        "f": ">=",
        "p": {
         "In1": "PV_Sec_Purge_ON",
         "In2": "SET_Time_Purge_ON"
        }
       },
       {
        "f": "MOVE",
        "p": {
         "In": "0",
         "OUT:Out": "PV_Minuti_Purge_OFF"
        }
       },
       {
        "f": "MOVE",
        "p": {
         "In": "0",
         "OUT:Out": "PV_Sec_Purge_ON"
        }
       }
      ]
     ]
    },
    {
     "cmt": "",
     "chain": [
      "/V_S_Enable_Purge",
      {
       "f": "MOVE",
       "p": {
        "In": "0",
        "OUT:Out": "PV_Minuti_Purge_OFF"
       }
      },
      {
       "f": "MOVE",
       "p": {
        "In": "0",
        "OUT:Out": "PV_Sec_Purge_ON"
       }
      }
     ]
    },
    {
     "cmt": "SCARICO",
     "chain": [
      "IN_EMERGENZA",
      {
       "or": [
        "V_S_Scarico",
        "Purge_Auto"
       ]
      },
      "/OUT_EV_ACQUA",
      "(OUT_EV_SCARICO)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      "OUT_EV_SCARICO",
      {
       "f": "<",
       "p": {
        "In1": "PV_mm_Livello",
        "In2": "REAL#12"
       }
      },
      {
       "fb": "TON",
       "inst": "Tim_2",
       "p": {
        "PT": "T#60s"
       }
      },
      "(R V_S_Scarico)"
     ]
    }
   ],
