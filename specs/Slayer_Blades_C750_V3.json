{
 "progetto": "Slayer_Blades_C750_V3",
 "guid": "e94c8f8d-b62b-4adb-bb61-053b33fc5403",
 "sections": {
  "Aspiratore": {
   "rungs": [
    {
     "cmt": "#MARCIA ASPIRATORE:ATTIVO IL RELè DI SICUREZZA PER LA MARCIA ASPIRATORE",
     "chain": [
      "P_On"
     ],
     "out": [
      [
       "^V_P_Marcia_Aspira",
       "(S Mem_Marcia_Aspiratore)"
      ],
      [
       "IN_RELE_SICUREZZA",
       "(V_L_Marcia_Aspira)"
      ]
     ]
    },
    {
     "cmt": "",
     "chain": [
      {
       "or": [
        "OUT_ARRESTO_ASPIRATORE",
        "IN_EMERGENZA",
        "Mem_Arresto_Aspiratore"
       ]
      },
      "(R Mem_Marcia_Aspiratore)"
     ]
    },
    {
     "cmt": "TIMER DISATTIVAZIONE DELLA MEMORIA DI MARCIA ASPIRATORE",
     "chain": [
      "Mem_Marcia_Aspiratore",
      {
       "fb": "TON",
       "inst": "Tim1",
       "p": {
        "PT": "T#1s"
       }
      }
     ]
    },
    {
     "cmt": "OUTPUT MARCIA ASPIRATORE",
     "chain": [
      "Mem_Marcia_Aspiratore",
      "/Tim1.Q",
      "(OUT_MARCIA_ASPIRATORE)"
     ]
    },
    {
     "cmt": "DOPO 1 SECONDO CHE HO IL RELè DI SICUREZZA ATTIVO AVVIO L'INVERTER",
     "chain": [
      "/IN_EMERGENZA",
      "IN_RELE_SICUREZZA",
      "/Inverter_STS.ManualControlMode",
      "/Inverter_STS.Emergenza",
      {
       "fb": "TON",
       "inst": "Tim2",
       "p": {
        "PT": "T#1s"
       }
      },
      "/Mem_Arresto_Aspiratore",
      "/Speed_0_Orologio",
      "/OUT_EV_1",
      "/OUT_EV_2"
     ],
     "out": [
      "(OUT_START_INVERTER)",
      [
       "OUT_START_INVERTER",
       "(Inverter_CMD.DriveRun)"
      ]
     ]
    },
    {
     "cmt": "VELOCITà ASPIRATORE",
     "chain": [
      "P_On",
      {
       "or": [
        [
         "/V_P_Orologio",
         {
          "f": "MOVE",
          "p": {
           "In": "SET_Speed_Manu_Inverter",
           "OUT:Out": "Inverter_CMD.FreqSetpoint"
          }
         },
         {
          "f": "MOVE",
          "p": {
           "In": "SET_Speed_Manu_Inverter",
           "OUT:Out": "PV_Set_Speed_Inverter"
          }
         }
        ],
        [
         "V_P_Orologio",
         {
          "or": [
           [
            {
             "f": "<=",
             "p": {
              "In1": "SET_Speed_Auto_Inverter",
              "In2": "int#50"
             }
            },
            {
             "f": "MUL",
             "p": {
              "In1": "SET_Speed_Auto_Inverter",
              "In2": "int#10",
              "OUT:": "MUL_SET_Speed_Auto_Inverter"
             }
            },
            {
             "f": "MOVE",
             "p": {
              "In": "MUL_SET_Speed_Auto_Inverter",
              "OUT:Out": "Inverter_CMD.FreqSetpoint"
             }
            },
            {
             "f": "MOVE",
             "p": {
              "In": "MUL_SET_Speed_Auto_Inverter",
              "OUT:Out": "PV_Set_Speed_Inverter"
             }
            }
           ],
           [
            {
             "f": "=",
             "p": {
              "In1": "SET_Speed_Auto_Inverter",
              "In2": "0"
             }
            },
            "(Speed_0_Orologio)"
           ]
          ]
         }
        ]
       ]
      }
     ]
    },
    {
     "cmt": "",
     "chain": [
      "P_On"
     ],
     "out": [
      [
       {
        "f": "<=",
        "p": {
         "In1": "SET_Speed_Auto_Inverter",
         "In2": "0"
        }
       },
       {
        "f": "MOVE",
        "p": {
         "In": "0",
         "OUT:Out": "SET_Speed_Auto_Inverter"
        }
       }
      ],
      [
       {
        "f": "<=",
        "p": {
         "In1": "SET_Speed_Manu_Inverter",
         "In2": "0"
        }
       },
       {
        "f": "MOVE",
        "p": {
         "In": "0",
         "OUT:Out": "SET_Speed_Manu_Inverter"
        }
       }
      ]
     ]
    },
    {
     "cmt": "#ARRESTO ASPIRATORE",
     "chain": [
      "P_On"
     ],
     "out": [
      [
       "^V_P_Arresto_Aspira",
       "(S Mem_Arresto_Aspiratore)"
      ],
      [
       "Mem_Arresto_Aspiratore",
       {
        "f": "Get1sClk",
        "p": {}
       },
       "(V_L_Arresto_Aspira)"
      ]
     ]
    },
    {
     "cmt": "",
     "chain": [
      {
       "or": [
        "IN_EMERGENZA",
        "/IN_RELE_SICUREZZA"
       ]
      },
      "(R Mem_Arresto_Aspiratore)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      "Mem_Arresto_Aspiratore",
      "/Inverter_STS.DriveRunning",
      "(OUT_ARRESTO_ASPIRATORE)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      "_EIP1_EstbTargetSta[3]",
      "(Ethernet_Inverter_OK)"
     ]
    },
    {
     "cmt": "TRASFERISCO VALORI STATO INVERTER",
     "chain": [
      {
       "ist": "PV_Inverter_Speed:=Inverter_STS.OutputFrequency;\r\nPV_Inverter_Current:=Inverter_STS.OutputCurrent;\r\nPV_Inverter_Error:=Inverter_STS.DriveTripCode;\r\nPV_Inverter_Power:=Inverter_STS.PDOWord4;\r\n"
      }
     ]
    },
    {
     "cmt": "",
     "chain": [
      {
       "f": ">",
       "p": {
        "In1": "PV_Inverter_Speed",
        "In2": "INT#0"
       }
      },
      "(PV_Inverter_Enable)"
     ]
    },
    {
     "cmt": "CONTEGGIO ORE DI FUNZIONAMENTO ASPIRATORE",
     "chain": [
      "OUT_START_INVERTER",
      "^Clock_1Min",
      {
       "f": "@Inc",
       "p": {
        "InOut": "PV_Contaore",
        "OUT:InOut": "PV_Contaore"
       }
      }
     ]
    },
    {
     "cmt": "",
     "chain": [
      {
       "f": "Get1minClk",
       "p": {}
      },
      "(Clock_1Min)"
     ]
    }
   ],
