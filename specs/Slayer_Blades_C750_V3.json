  "Allarmi": {
   "rungs": [
    {
     "cmt": "Accendo la spia Allarmi del visualizzatore se ho un bit Allarmi Attivo",
     "chain": [
      {
       "f": "ArySearch",
       "p": {
        "In": "Allarme_Bit[1]",
        "Size": "uint#10",
        "Key": "bool#1",
        "InOutPos": "local1",
        "OUT:": "Spia_Allarme",
        "OUT:InOutPos": "local1"
       }
      },
      "Spia_Allarme",
      {
       "f": "Get1sClk",
       "p": {}
      }
     ],
     "out": [
      "(V_L_Allarmi)",
      "(OUT_LAMP)"
     ]
    },
    {
     "cmt": "ALLARME 1: EMERGENZA PREMUTA",
     "chain": [
      "IN_EMERGENZA",
      "(Allarme_Bit[1])"
     ]
    },
    {
     "cmt": "ALLARME 2: INVERTER NO READY",
     "chain": [
      "Inverter_STS.Emergenza",
      "/Allarme_Bit[4]",
      {
       "fb": "TON",
       "inst": "Tim3",
       "p": {
        "PT": "T#2s"
       }
      },
      "(Allarme_Bit[2])"
     ]
    },
    {
     "cmt": "ALLARME 3: LIVELLO MASSIMO ACQUA  CROMO 1",
     "chain": [
      "IN_LIV_MAX_CROMO_1",
      "(Allarme_Bit[3])"
     ]
    },
    {
     "cmt": "ALLARME 4: MARCIA ASPIRATORE OFF",
     "chain": [
      "/IN_RELE_SICUREZZA",
      "(Allarme_Bit[4])"
     ]
    },
    {
     "cmt": "ALLARME 5: INVERTER IN MANUALE",
     "chain": [
      "Inverter_STS.ManualControlMode",
      "(Allarme_Bit[5])"
     ]
    },
    {
     "cmt": "ALLARME 6: ERRORE CONNESSIONE ETHERNET INVERTER",
     "chain": [
      "/_EIP1_EstbTargetSta[3]",
      "(Allarme_Bit[6])"
     ]
    },
    {
     "cmt": "ALLARME 7: FAULT INVERTER",
     "chain": [
      "Inverter_STS.DriveFault",
      "(Allarme_Bit[7])"
     ]
    }
   ],
