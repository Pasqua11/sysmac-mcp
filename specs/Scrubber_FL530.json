 "sections": {
  "Aspiratore": {
   "rungs": [
    {
     "cmt": "VERIFICO CHE  è STATA DISATTIVATA LA MARCIA GENERALE",
     "chain": [
      "vIN_MARCIA",
      "(S Arresto_Marcia)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      "Arresto_Marcia",
      {
       "fb": "TON",
       "inst": "Tim_Arresto_Marcia",
       "p": {
        "PT": "T#20s"
       }
      },
      "(R Arresto_Marcia)"
     ]
    },
    {
     "cmt": "COMANDO ASPIRATORE",
     "chain": [
      "IN_MARCIA",
      "Enable_Aspira",
      "Power_Inverter1",
      {
       "fb": "TON",
       "inst": "Tim_1",
       "p": {
        "PT": "T#1s"
       }
      },
      "/Arresto_Marcia",
      {
       "fb": "INV003_3G3M1_ECT",
       "inst": "COMMAND_ASPIRA",
       "p": {
        "Command": "ASPIRA_Command",
        "FrequencyReference": "ASPIRA_Frequency_Reference",
        "OutputFrequencyMonitor": "ASPIRA_Output_Frequency_Monitor",
        "Status": "ASPIRA_Status",
        "Acceleration": "ASPIRA_Output_F007_1st_Acceleration_Time_1",
        "Deceleration": "ASPIRA_Output_F008_1st_Deceleration_Time_1",
        "ForwardRun": "Fwd_ASPIRA",
        "ReverseRun": "Rev_ASPIRA",
        "CmdFrequencyReference": "SET_Frequenza_ASPIRA",
        "CmdAccelerationReference": "Accellerazione_ASPIRA",
        "CmdDecelerationReference": "Decellerazione_ASPIRA",
        "FaultReset": "FaultReset_ASPIRA",
        "OUT:Command": "ASPIRA_Command",
        "OUT:FrequencyReference": "ASPIRA_Frequency_Reference",
        "OUT:OutputFrequencyMonitor": "ASPIRA_Output_Frequency_Monitor",
        "OUT:Status": "ASPIRA_Status",
        "OUT:Acceleration": "ASPIRA_Output_F007_1st_Acceleration_Time_1",
        "OUT:Deceleration": "ASPIRA_Output_F008_1st_Deceleration_Time_1",
        "OUT:DriveStatus": "ASPIRA_DriveStatus",
        "OUT:ActOutputFrequencyMonitor": "PV_ASPIRA_ActOutFreqMonitor"
       }
      },
      "ASPIRA_DriveStatus.ForwardOperationInProgress",
      "(ASPIRA_Active)"
     ]
    },
    {
     "cmt": "TESTO SE HO ALIMENTATO L'INVERTER 1",
     "chain": [
      {
       "f": "UINT_TO_WORD",
       "p": {
        "In": "ASPIRA_M014_Operation_Status_1_Monitor",
        "OUT:": "ASPIRA_M014_WORD"
       }
      }
     ],
     "out": [
      [
       {
        "f": "TestABit",
        "p": {
         "In": "ASPIRA_M014_WORD",
         "Pos": "5"
        }
       },
       "(Power_Inverter1)"
      ],
      [
       {
        "f": "TestABit",
        "p": {
         "In": "ASPIRA_M014_WORD",
         "Pos": "11"
        }
       },
       "(Alarm_Inverter1)"
      ]
     ]
    },
    {
     "cmt": "ALLARMI INVERTER1",
     "chain": [
      {
       "fb": "INV000_3G3M1_Alarm",
       "inst": "Allarmi_Inverter_Aspira",
       "p": {
        "Status": "ASPIRA_Status",
        "NodeAddress": "UINT#1",
        "OUT:Status": "ASPIRA_Status",
        "OUT:Busy": "Busy_ASPIRA",
        "OUT:ErrorCodeInfo": "ErrorCodeInfo_Aspira",
        "OUT:ErrorCode": "ErrorCode_ASPIRA"
       }
      },
      "(Error_P1)"
     ]
    },
    {
     "cmt": "TRSFERIMENTO DATI SETTAGGIO INVERTER ",
     "chain": [
      {
       "ist": "Fwd_ASPIRA:=1;\r\nAccellerazione_ASPIRA:=30.0;\r\nDecellerazione_ASPIRA:=30.0;\r\n"
      }
     ]
    },
    {
     "cmt": "CONRTEGGIO ORE DI FUZIONAMENTO ASPIRATORE",
     "chain": [
      "IN_MARCIA",
      "ASPIRA_Active",
      "^Clock_1Min",
      {
       "f": "@Inc",
       "p": {
        "InOut": "PV_Minuti_ASPIRA",
        "OUT:InOut": "PV_Minuti_ASPIRA"
       }
      }
     ]
    },
    {
     "cmt": "GESTIONE LOCALE REMOTO",
     "chain": [
      "V_S_Enable_Aspira"
     ],
     "out": [
      "(V_L_Enable_Aspiratore)",
      "(Enable_Aspira)"
     ]
    }
   ],
