 "sections": {
  "Marcia_Asse": {
   "rungs": [
    {
     "cmt": "RITARDO ABILITAZIONE SERVO",
     "chain": [
      "Marcia_ON",
      "/Allarme_Bit[3]",
      {
       "fb": "TON",
       "inst": "Tim1",
       "p": {
        "PT": "T#1s"
       }
      }
     ]
    },
    {
     "cmt": "",
     "chain": [
      "/IN_Stop",
      "(R Marcia_ON)"
     ]
    },
    {
     "cmt": "ABILITAZIONE SERVO",
     "chain": [
      "Tim1.Q",
      "MC_Y.DrvStatus.Ready",
      "MC_Y.DrvStatus.MainPower",
      {
       "fb": "MC_Power",
       "inst": "Power_Y",
       "p": {
        "Axis": "MC_Y",
        "OUT:Axis": "MC_Y"
       }
      }
     ]
    },
    {
     "cmt": "RESET ALLARME ASSE",
     "chain": [
      {
       "or": [
        "V_P_Reset_All_Assi",
        "Abort_Ciclo"
       ]
      },
      {
       "fb": "MC_Reset",
       "inst": "Y_Reset_Error",
       "p": {
        "Axis": "MC_Y",
        "OUT:Axis": "MC_Y"
       }
      }
     ]
    },
    {
     "cmt": "ASSE READY",
     "chain": [
      "MC_Y.DrvStatus.ServoOn",
      "/MC_Y.DrvStatus.DrvAlarm",
      "/MC_Y.DrvStatus.DrvWarning",
      "/MC_Y.MFaultLvl.Active",
      "(Robot_Ready)"
     ]
    },
    {
     "cmt": "MANUALE LIFT",
     "chain": [
      "/Start_Reset_Robot",
      "Robot_Ready"
     ],
     "out": [
      [
       "Y_Jog_GIU",
       {
        "fb": "MC_MoveJog",
        "inst": "Manu_Y",
        "p": {
         "Axis": "MC_Y",
         "NegativeEnable": "Y_Jog_SU",
         "Velocity": "5",
         "Acceleration": "20",
         "Deceleration": "100000",
         "OUT:Axis": "MC_Y"
        }
       }
      ],
      [
       "V_P_Up",
       "/Y_Jog_GIU",
       {
        "f": ">=",
        "p": {
         "In1": "Posizione_Asse_Y",
         "In2": "0"
        }
       },
       "(Y_Jog_SU)"
      ],
      [
       "V_P_Down",
       "/Y_Jog_SU",
       {
        "f": "<",
        "p": {
         "In1": "Posizione_Asse_Y",
         "In2": "275"
        }
       },
       "(Y_Jog_GIU)"
      ]
     ]
    }
   ],
