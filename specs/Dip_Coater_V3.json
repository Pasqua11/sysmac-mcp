  "Trasf_Dati": {
   "rungs": [
    {
     "cmt": "",
     "chain": [
      {
       "ist": "Posizione_Asse_Y:=MC_Y.Act.Pos;\r\nY_Origin:=MC_Y.DrvStatus.HomeSw;\r\nY_Allarm_Code:=MC_Y.MFaultLvl.Code;\r\nY_Coppia:=MC_Y.Act.Trq;\r\nAsse_Allarm_Code:=MC_Y.MFaultLvl.Code;"
      }
     ]
    },
    {
     "cmt": "TRASFERISCO LA RICETTA EDIT NELLE MEMORIE",
     "chain": [
      "Ricetta_Save",
      {
       "f": "MOVE",
       "p": {
        "In": "Ricetta_Edit",
        "OUT:Out": "Ricetta_Memoria[Ricetta_Id]"
       }
      },
      {
       "fb": "TON",
       "inst": "Tim9",
       "p": {
        "PT": "T#2s"
       }
      },
      "(R Ricetta_Save)"
     ]
    },
    {
     "cmt": "TRASFERISCO LA RICETTA DALLE MEMORIE ALL'EDIT",
     "chain": [
      "Ricetta_Load",
      {
       "f": "MOVE",
       "p": {
        "In": "Ricetta_Memoria[Ricetta_Id]",
        "OUT:Out": "Ricetta_Edit"
       }
      }
     ]
    },
    {
     "cmt": "TRASFERISCO LA RICETTA DALLE MEMORIE AL CICLO MACCHINA",
     "chain": [
      {
       "ist": "SET_Tim_Immersione:=Ricetta_Memoria[Ricetta_Id_Menu].Tim_Immersione_min*60+Ricetta_Memoria[Ricetta_Id_Menu].Tim_Immersione_sec;\r\nSET_Tim_Start_Agita:=Ricetta_Memoria[Ricetta_Id_Menu].Tim_Start_Agita_min*60+Ricetta_Memoria[Ricetta_Id_Menu].Tim_Start_Agita_sec;\r\nSET_Tim_Durata_Agita:=Ricetta_Memoria[Ricetta_Id_Menu].Tim_Durata_Agita_min*60+Ricetta_Memoria[Ricetta_Id_Menu].Tim_Durata_Agita_sec;\r\nSET_Speed_Down:=Ricetta_Memoria[Ricetta_Id_Menu].Speed_Down;\r\nSET_Speed_Up:=Ricetta_Memoria[Ricetta_Id_Menu].Speed_Up;\r\nSET_Speed_Agita:=Ricetta_Memoria[Ricetta_Id_Menu].Speed_Agita;\r\nSET_Isteresi_Agita:=Ricetta_Memoria[Ricetta_Id_Menu].Isteresi_Agita;\r\nSET_Pos_Discesa:=Ricetta_Memoria[Ricetta_Id_Menu].Pos_Discesa;\r\nSET_Enable_Agita:=Ricetta_Memoria[Ricetta_Id_Menu].Enable_Agita;"
      }
     ]
    },
    {
     "cmt": "SCALO IL VALORE DI POSIZIONE DELL'ASSE Y PER UTILIZZARLO NELLA VISUALIZZAZIONE",
     "chain": [
      {
       "f": "ScaleTrans",
       "p": {
        "SclIn": "MC_Y.Act.Pos",
        "X0": "real#0",
        "Y0": "real#0",
        "X1": "real#275",
        "Y1": "real#140",
        "OUT:": "Scala_Pos_Asse_Y"
       }
      }
     ]
    },
    {
     "cmt": "ABILITO LA REGISTRAZIONE DEL LOG DI COPPIA",
     "chain": [
      {
       "or": [
        "MOV1.Active",
        "MOV2.Active"
       ]
      },
      "(LOG_Coppia_Enable)"
     ]
    }
   ],
