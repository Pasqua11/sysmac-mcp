  "Reset_Movimenti": {
   "rungs": [
    {
     "cmt": "RESET ASSI ASSOLUTO.SI FA SOLO CON CAMBIO MOTORI.IN JOG IN POSIZIONE DI ZERO ATTIVARE SEQUENZA.",
     "chain": [
      "^Reset_Assoluto_Y",
      {
       "fb": "MC_Home",
       "inst": "Home_Y",
       "p": {
        "Axis": "MC_Y",
        "OUT:Axis": "MC_Y"
       }
      }
     ]
    },
    {
     "cmt": "RESET ASSE: INIZIO SEQUENZA",
     "chain": [
      "P_On"
     ],
     "out": [
      [
       "Robot_Ready",
       "V_P_Start_Reset",
       "(S Start_Reset_Robot)"
      ],
      [
       "Abort_Ciclo",
       "(R Start_Reset_Robot)"
      ]
     ]
    },
    {
     "cmt": "RESET ASSI",
     "chain": [
      "Start_Reset_Robot",
      "/End_Reset_Robot",
      {
       "fb": "MC_MoveAbsolute",
       "inst": "Y_Reset_Asse",
       "p": {
        "Axis": "MC_Y",
        "Position": "0",
        "Velocity": "5",
        "Acceleration": "50",
        "Deceleration": "50",
        "OUT:Axis": "MC_Y"
       }
      },
      "(S End_Reset_Robot)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      "Abort_Ciclo",
      "(R End_Reset_Robot)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      "Start_Reset_Robot",
      "/End_Reset_Robot",
      "(V_L_Reset_Lift)"
     ]
    }
