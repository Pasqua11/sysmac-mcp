  "Movimentazione": {
   "rungs": [
    {
     "cmt": "START CICLO",
     "chain": [
      {
       "or": [
        "^V_P_Start_Ciclo",
        [
         "Simu1",
         {
          "f": "Get1sClk",
          "p": {}
         }
        ]
       ]
      },
      "Macchina_OK",
      "/Mem_Start_Mov1",
      "(S Mem_Ciclo)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      {
       "or": [
        [
         "V_P_Stop_Ciclo",
         {
          "fb": "TON",
          "inst": "Tim5",
          "p": {
           "PT": "T#1s"
          }
         }
        ],
        "V_P_Start_Reset",
        "CNT_Processo.End_Conteggio",
        "P_First_Run"
       ]
      },
      "(R Mem_Ciclo)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      {
       "or": [
        "Mem_Ciclo",
        "Mem_Start_Mov1",
        "End_Ciclo"
       ]
      },
      "(V_L_Fetta)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      {
       "or": [
        [
         "V_P_Stop_Ciclo",
         {
          "fb": "TON",
          "inst": "Tim6",
          "p": {
           "PT": "T#1s"
          }
         }
        ],
        [
         "Simu1",
         "End_Ciclo",
         {
          "f": "Get1sClk",
          "p": {}
         }
        ]
       ]
      },
      "(R End_Ciclo)"
     ]
    },
    {
     "cmt": "CONTEGGIO TEMPO DI PROCESSO",
     "chain": [
      "Mem_Ciclo",
      "Mem_End_Mov1",
      {
       "fb": "Contatore",
       "inst": "CNT_Processo",
       "p": {
        "SET_VALUE": "SET_Tim_Immersione",
        "VALUE": "PV_Tim_Immersione",
        "OUT:VALUE": "PV_Tim_Immersione"
       }
      },
      "(S End_Ciclo)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      "End_Ciclo",
      "(OUT_Buzzer)"
     ]
    },
    {
     "cmt": "ASSE OK PER MOVIMENTAZIONE",
     "chain": [
      "End_Reset_Robot",
      "Robot_Ready",
      "(Macchina_OK)"
     ]
    },
    {
     "cmt": "LIFT: START MOVIMENTO DI DISCESA",
     "chain": [
      "Macchina_OK",
      "^Mem_Ciclo",
      "(S Mem_Start_Mov1)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      {
       "or": [
        "/End_Reset_Robot",
        "Mem_End_Mov2"
       ]
      },
      "(R Mem_Start_Mov1)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      "Macchina_OK",
      "Mem_Start_Mov1",
      "/Mem_End_Mov1",
      {
       "fb": "MC_MoveAbsolute",
       "inst": "MOV1",
       "p": {
        "Axis": "MC_Y",
        "Position": "SET_Pos_Discesa",
        "Velocity": "SET_Speed_Down",
        "Acceleration": "50",
        "Deceleration": "50",
        "OUT:Axis": "MC_Y"
       }
      }
     ]
    },
    {
     "cmt": "LIFT: FINE  MOVIMENTO DI DISCESA",
     "chain": [
      "MOV1.Done",
      "(S Mem_End_Mov1)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      {
       "or": [
        "/End_Reset_Robot",
        "Mem_End_Mov2"
       ]
      },
      "(R Mem_End_Mov1)"
     ]
    },
    {
     "cmt": "RITARDO PARTENZA AGITAZIONE",
     "chain": [
      "Mem_End_Mov1",
      {
       "fb": "Contatore",
       "inst": "CNT_Start_Agita",
       "p": {
        "SET_VALUE": "SET_Tim_Start_Agita",
        "VALUE": "PV_Tim_Start_Agita",
        "OUT:VALUE": "PV_Tim_Start_Agita"
       }
      }
     ]
    },
    {
     "cmt": "LIFT:SCADUTO IL TEMPO ATTIVO IL MOVIMENTO DI SALITA",
     "chain": [
      "Macchina_OK",
      "Mem_End_Mov1",
      "/Mem_Ciclo",
      "/Mem_Start_UP_Agita",
      {
       "fb": "TON",
       "inst": "Tim2",
       "p": {
        "PT": "T#1s"
       }
      },
      "(S Mem_Start_Mov2)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      {
       "or": [
        "/End_Reset_Robot",
        "Mem_End_Mov2"
       ]
      },
      "(R Mem_Start_Mov2)"
     ]
    },
    {
     "cmt": "LIFT:FINE  MOVIMENTO DI SALITA",
     "chain": [
      "Macchina_OK",
      "Mem_Start_Mov2",
      "/Mem_End_Mov2",
      {
       "fb": "MC_MoveAbsolute",
       "inst": "MOV2",
       "p": {
        "Axis": "MC_Y",
        "Position": "0",
        "Velocity": "SET_Speed_Up",
        "Acceleration": "50",
        "Deceleration": "50",
        "OUT:Axis": "MC_Y"
       }
      },
      "(Mem_End_Mov2)"
     ]
    },
    {
     "cmt": "AGITAZIONE:PARTO CON L'AGITAZIONE VERSO L'ALTO",
     "chain": [
      "Macchina_OK",
      "Mem_End_Mov1",
      "CNT_Start_Agita.End_Conteggio",
      "SET_Enable_Agita",
      "Mem_Ciclo",
      "/CNT_Agitazione.End_Conteggio",
      "(S Mem_Start_UP_Agita)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      "Mem_Start_UP_Agita",
      "(V_L_Agita_LIft)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      {
       "or": [
        "Mem_End_Down_Agita",
        "/End_Reset_Robot"
       ]
      },
      "(R Mem_Start_UP_Agita)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      {
       "ist": "Position_Lift_Agita_UP:=SET_Pos_Discesa - SET_Isteresi_Agita;"
      }
     ]
    },
    {
     "cmt": "",
     "chain": [
      "Macchina_OK",
      "Mem_Start_UP_Agita",
      {
       "fb": "TON",
       "inst": "Tim3",
       "p": {
        "PT": "T#500ms"
       }
      },
      "/Mem_End_UP_Agita",
      {
       "fb": "MC_MoveAbsolute",
       "inst": "MOV_AGITA_UP",
       "p": {
        "Axis": "MC_Y",
        "Position": "Position_Lift_Agita_UP",
        "Velocity": "SET_Speed_Agita",
        "Acceleration": "20",
        "Deceleration": "20",
        "OUT:Axis": "MC_Y"
       }
      }
     ]
    },
    {
     "cmt": "FINE AGITAZIONE VERSO L'ALTO",
     "chain": [
      "MOV_AGITA_UP.Done",
      "(S Mem_End_UP_Agita)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      {
       "or": [
        "/End_Reset_Robot",
        "Mem_End_Down_Agita"
       ]
      },
      "(R Mem_End_UP_Agita)"
     ]
    },
    {
     "cmt": "AGITAZIONEPARTO CON L'AGITAZIONE VERSO IL BASSO",
     "chain": [
      "Mem_End_UP_Agita",
      {
       "fb": "TON",
       "inst": "Tim4",
       "p": {
        "PT": "T#500ms"
       }
      },
      "(S Mem_Start_DOWN_Agita)"
     ]
    },
    {
     "cmt": "",
     "chain": [
      {
       "or": [
        "/End_Reset_Robot",
        "Mem_End_Down_Agita"
       ]
      },
      "(R Mem_Start_DOWN_Agita)"
     ]
    },
    {
     "cmt": "AGITAZIONE: FINE SEQUENZA AGITAZIONE",
     "chain": [
      "Macchina_OK",
      "Mem_Start_DOWN_Agita",
      {
       "fb": "MC_MoveAbsolute",
