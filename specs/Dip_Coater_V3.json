  "Allarmi": {
   "rungs": [
    {
     "cmt": "Accendo la spia Allarmi del visualizzatore se ho un bit Allarmi Attivo",
     "chain": [
      {
       "f": "ArySearch",
       "p": {
        "In": "Allarme_Bit[1]",
        "Size": "uint#10",
        "Key": "bool#1",
        "InOutPos": "local1",
        "OUT:": "Spia_Allarme",
        "OUT:InOutPos": "local1"
       }
      },
      "Spia_Allarme",
      {
       "f": "Get1sClk",
       "p": {}
      },
      "(V_L_Allarmi)"
     ]
    },
    {
     "cmt": "VISUALIZZO ERRORE DRIVER",
     "chain": [
      {
       "fb": "Drive_Error_Warning",
       "inst": "Asse_Drive_Error",
       "p": {
        "Node": "uint#1",
        "OUT:Warning": "Asse_Warning",
        "OUT:Errore": "Asse_Error"
       }
      }
     ]
    },
    {
     "cmt": "ALLARME 1: ERRORE ASSE ",
     "chain": [
      "P_On",
      {
       "or": [
        "MC_Y.DrvStatus.DrvAlarm",
        "MC_Y.DrvStatus.DrvWarning",
        "MC_Y.MFaultLvl.Active"
       ]
      },
      "(Allarme_Bit[1])"
     ]
    },
    {
     "cmt": "ALLARME 2: RESET ASSE  NECESSARIO",
     "chain": [
      "/End_Reset_Robot",
      "(Allarme_Bit[2])"
     ]
    },
    {
     "cmt": "COPPIA MINIMA APPLICATA IN MANUALE E DURANTE LA SEQUENZA DI RESET ROBOT",
     "chain": [
      "/Start_Reset_Robot",
      {
       "f": "MOVE",
       "p": {
        "In": "SET_Allarme_Coppia_Min",
        "OUT:Out": "SET_Allarme_Coppia_Down"
       }
      },
      {
       "f": "MOVE",
       "p": {
        "In": "SET_Allarme_Coppia_Min",
        "OUT:Out": "SET_Allarme_Coppia_Up"
       }
      }
     ]
    },
    {
     "cmt": "COPPIA MASSIMA DI SICUREZZA",
     "chain": [
      "End_Reset_Robot",
      {
       "f": "MOVE",
       "p": {
        "In": "SET_Allarme_Coppia_Max",
        "OUT:Out": "SET_Allarme_Coppia_Down"
       }
      },
      {
       "f": "MOVE",
       "p": {
        "In": "SET_Allarme_Coppia_Max",
        "OUT:Out": "SET_Allarme_Coppia_Up"
       }
      }
     ]
    },
    {
     "cmt": "",
     "chain": [
      {
       "ist": "SET_Allarme_Coppia_Up2:=SET_Allarme_Coppia_Up* -1-2;"
      }
     ]
    },
    {
     "cmt": "ALLARME COPPIA ADATTIVA IN DISCESA CALCOLATA NEL MOMENTO INIZIALE DELLA DISCESA",
     "chain": [
      {
       "or": [
        "MOV1.Active",
        "MOV_AGITA_DOWN.Active"
       ]
      },
      {
       "fb": "TON",
       "inst": "Tim10",
       "p": {
        "PT": "T#1S"
       }
      }
     ],
     "out": [
      [
       {
        "f": "@MOVE",
        "p": {
         "In": "Y_Coppia",
         "OUT:Out": "Y_Coppia_Start_Mov1"
        }
       },
       {
        "f": "+",
        "p": {
         "In1": "Y_Coppia_Start_Mov1",
         "In2": "SET_Allarme_Coppia_Adattiva",
         "OUT:": "Y_Coppia_Adattiva_Mov1"
        }
       }
      ],
      [
       "Tim10.Q",
       "(Enable_Copp_Adatt_Mov1)"
      ]
     ]
    },
    {
     "cmt": "ALLARME COPPIA ADATTIVA IN SALITA CALCOLATA NEL MOMENTO INIZIALE DELLA SALITA",
     "chain": [
      {
       "or": [
        "MOV2.Active",
        "MOV_AGITA_UP.Active",
        "Y_Reset_Asse.Active"
       ]
      },
      {
       "fb": "TON",
       "inst": "Tim11",
       "p": {
        "PT": "T#1S"
       }
      }
     ],
     "out": [
      [
       {
        "f": "@MOVE",
        "p": {
         "In": "Y_Coppia",
         "OUT:Out": "Y_Coppia_Start_Mov2"
        }
       },
       {
        "f": "-",
        "p": {
         "In1": "Y_Coppia_Start_Mov2",
         "In2": "SET_Allarme_Coppia_Adattiva",
         "OUT:": "Y_Coppia_Adattiva_Mov2"
        }
       },
       "(Enable_Copp_Adatt_Mov2)"
      ],
      [
       "Tim11.Q",
       "(Enable_Copp_Adatt_Mov2)"
      ]
     ]
    },
    {
     "cmt": "ALLARME 3: ERRORE COPPIA ASSE ",
     "chain": [
      "P_On"
     ],
     "out": [
      [
       {
        "or": [
         {
          "f": ">",
          "p": {
           "In1": "Y_Coppia",
           "In2": "SET_Allarme_Coppia_Down"
          }
         },
         [
          {
           "or": [
            "MOV1.Active",
            "MOV_AGITA_DOWN.Active"
           ]
          },
          "Enable_Copp_Adatt_Mov1",
          {
           "f": ">",
           "p": {
            "In1": "Y_Coppia",
            "In2": "Y_Coppia_Adattiva_Mov1"
           }
          }
         ],
         [
          {
           "or": [
            "MOV2.Active",
            "MOV_AGITA_UP.Active",
            "Y_Reset_Asse.Active"
           ]
          },
          "Enable_Copp_Adatt_Mov2",
          {
           "f": "<",
           "p": {
            "In1": "Y_Coppia",
            "In2": "Y_Coppia_Adattiva_Mov2"
           }
          }
         ],
         {
          "f": "<",
          "p": {
           "In1": "Y_Coppia",
           "In2": "SET_Allarme_Coppia_Up2"
          }
         }
        ]
       },
       {
        "fb": "TON",
        "inst": "Tim7",
        "p": {
         "PT": "T#200ms"
        }
       },
       "(S Allarme_Bit[3])"
      ],
      [
       "Abort_Ciclo",
       "(R Allarme_Bit[3])"
      ]
     ]
    },
    {
     "cmt": "",
     "chain": [
      "P_On",
      {
       "f": ">=",
       "p": {
        "In1": "Y_Coppia",
        "In2": "0"
       }
      }
     ],
     "out": [
      [
       "End_Reset_Robot",
       {
        "f": "MOVE",
        "p": {
         "In": "Y_Coppia_Adattiva_Mov1",
         "OUT:Out": "PV_Allarme_Coppia"
        }
       }
      ],
      [
       "/Start_Reset_Robot",
       {
        "f": "MOVE",
        "p": {
         "In": "SET_Allarme_Coppia_Down",
         "OUT:Out": "PV_Allarme_Coppia"
        }
       }
      ]
     ]
    },
    {
     "cmt": "",
     "chain": [
      "P_On",
      {
       "f": "<",
       "p": {
        "In1": "Y_Coppia",
        "In2": "0"
       }
      }
     ],
     "out": [
      [
       {
        "or": [
         "End_Reset_Robot",
         "Start_Reset_Robot"
        ]
       },
       {
        "f": "MOVE",
        "p": {
         "In": "Y_Coppia_Adattiva_Mov2",
         "OUT:Out": "PV_Allarme_Coppia"
        }
       }
      ],
      [
       "/Start_Reset_Robot",
       {
        "f": "MOVE",
        "p": {
         "In": "SET_Allarme_Coppia_Up2",
         "OUT:Out": "PV_Allarme_Coppia"
        }
       }
      ]
     ]
    },
    {
     "cmt": "ALLARME 4: MARCIA OFF",
     "chain": [
      "/Marcia_ON",
      "(Allarme_Bit[4])"
     ]
    }
   ],
