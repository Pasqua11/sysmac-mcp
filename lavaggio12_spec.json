        "Mem_Ciclo",
        "/V_S_Usa_V1",
        "Mem_Pieno"
       ]
      ]
     }
    ],
    "out": [
     [
      "(S End_V1)"
     ],
     [
      "(R Mem_V1)"
     ],
     [
      "(S Mem_Estrai)"
     ]
    ]
   },
   {
