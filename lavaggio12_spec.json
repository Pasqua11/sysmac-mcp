 "sections": {
  "Lavaggio": [
   {
    "cmt": "CONSENSI DI SICUREZZA",
    "chain": [
     "/IN_Emergenza",
     "IN_Protezioni",
     "IN_Press_Aria",
     "(Consensi)"
    ]
   },
   {
    "cmt": "START CICLO (azzera anche il fine ciclo precedente)",
    "chain": [
     "^V_P_Start",
     "Consensi",
     "V_S_Auto",
     "IN_Presenza_Cesto",
     "/Seq_Attiva"
    ],
    "out": [
     [
      "(R Mem_Fine)"
     ],
     [
      "(S Mem_Ciclo)"
     ]
    ]
   },
   {
    "cmt": "ARRESTO CICLO",
    "chain": [
     {
      "or": [
       "^V_P_Stop",
       "/Consensi",
       "Mem_Fine"
      ]
     },
     "(R Mem_Ciclo)"
    ]
   },
   {
    "cmt": "SEQUENZA ATTIVA: un passo qualsiasi in corso",
    "chain": [
     {
      "or": [
       "Mem_Carico",
       "Mem_V1",
       "Mem_V2",
       "Mem_V3",
       "Mem_V4",
       "Mem_V5",
       "Mem_V6",
       "Mem_V7",
       "Mem_V8",
       "Mem_V9",
       "Mem_V10",
       "Mem_V11",
       "Mem_V12",
       "Mem_Scarico"
      ]
     },
     "(Seq_Attiva)"
    ]
   },
   {
    "cmt": "CARRO SOPRA LA VASCA DA FARE: qui si ferma e cala il cestello",
    "chain": [
     "Mem_Ciclo",
     "Mem_Pieno",
     {
      "or": [
       [
        "V_S_Usa_V1",
        "/End_V1",
        "IN_Pos_V1"
       ],
       [
        "V_S_Usa_V2",
        "/End_V2",
        "IN_Pos_V2"
       ],
       [
        "V_S_Usa_V3",
        "/End_V3",
        "IN_Pos_V3"
       ],
       [
        "V_S_Usa_V4",
        "/End_V4",
        "IN_Pos_V4"
       ],
       [
        "V_S_Usa_V5",
        "/End_V5",
        "IN_Pos_V5"
       ],
       [
        "V_S_Usa_V6",
        "/End_V6",
        "IN_Pos_V6"
       ],
       [
        "V_S_Usa_V7",
        "/End_V7",
        "IN_Pos_V7"
       ],
       [
        "V_S_Usa_V8",
        "/End_V8",
        "IN_Pos_V8"
       ],
       [
        "V_S_Usa_V9",
        "/End_V9",
        "IN_Pos_V9"
       ],
       [
        "V_S_Usa_V10",
        "/End_V10",
        "IN_Pos_V10"
       ],
       [
        "V_S_Usa_V11",
        "/End_V11",
        "IN_Pos_V11"
       ],
       [
        "V_S_Usa_V12",
        "/End_V12",
        "IN_Pos_V12"
       ]
      ]
     },
     "(Mem_Target)"
    ]
   },
   {
    "cmt": "AZZERAMENTO PASSI A INIZIO CICLO",
    "chain": [
     "^V_P_Start"
    ],
    "out": [
     [
      "(R End_V1)"
     ],
     [
      "(R End_V2)"
     ],
     [
      "(R End_V3)"
     ],
     [
      "(R End_V4)"
     ],
     [
      "(R End_V5)"
     ],
     [
      "(R End_V6)"
     ],
     [
