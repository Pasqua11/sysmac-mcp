    "chain": [
     "Mem_Carico",
     "IN_Carro_Alto"
    ],
    "out": [
     [
      "(S Mem_Pieno)"
     ],
     [
      "(R Mem_Carico)"
     ]
    ]
   },
   {
    "cmt": "INGRESSO VASCA 1",
    "chain": [
     "Mem_Ciclo",
     "Mem_Pieno",
     "V_S_Usa_V1",
     "IN_Pos_V1",
