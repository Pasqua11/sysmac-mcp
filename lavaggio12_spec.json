    "cmt": "PRELIEVO AL CARICO",
    "chain": [
     "Mem_Ciclo",
     "IN_Pos_Carico",
     "IN_Presenza_Cesto",
     "/Mem_Pieno",
     "(S Mem_Carico)"
    ]
   },
   {
