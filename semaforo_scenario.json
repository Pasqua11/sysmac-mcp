{
 "nome": "Semaforo incrocio - collaudo completo",
 "commento": "Stesso file per il simulatore Python (sim_spec.py) e per il simulatore Sysmac (sysmac_api.collauda). I tempi qui sotto sono quelli di PROVA: verde 6 s invece di 25, cosi' un ciclo dura 20 s invece di 55.",
 "tempi": {
  "SET_T_Verde_NS": "T#6s",
  "SET_T_Verde_EO": "T#5s",
  "SET_T_Giallo": "T#2s",
  "SET_T_TuttoRosso": "T#1s",
  "SET_T_Verde_Min": "T#3s"
 },
 "passi": [
  {"descrizione": "impianto fermo: nessuna lampada di ciclo",
   "set": {"IN_Marcia": false, "V_S_Auto": true, "V_S_Notte": false, "IN_Emergenza": false},
   "attendi": 1,
   "verifica": {"OUT_NS_Verde": false, "OUT_EO_Verde": false}},

  {"descrizione": "avvio: parte la fase 1, verde NS e pedonale EO",
   "set": {"IN_Marcia": true},
   "attendi": 1,
   "verifica": {"OUT_NS_Verde": true, "OUT_EO_Rosso": true,
                "OUT_Ped_EO_Verde": true, "OUT_Ped_NS_Verde": false}},

  {"descrizione": "durata del verde NS senza chiamate (6 s impostati)",
   "durata": {"variabile": "OUT_NS_Verde", "valore": true, "min": 5.5, "max": 6.6}},

  {"descrizione": "dopo il verde NS arriva il giallo NS (2 s)",
   "durata": {"variabile": "OUT_NS_Giallo", "valore": true, "min": 1.6, "max": 2.5}},

  {"descrizione": "fase 4: verde EO e verde pedonale NS",
   "attendi": 1.5,
   "verifica": {"OUT_EO_Verde": true, "OUT_NS_Rosso": true,
                "OUT_Ped_NS_Verde": true, "OUT_Ped_EO_Verde": false}},

  {"descrizione": "chiamata pedonale NS: accende la spia di prenotazione",
   "impulso": ["V_P_Chiam_Ped_NS"],
   "attendi": 0.5,
   "verifica": {"V_L_Ped_NS_Prenotato": true}},

  {"descrizione": "la chiamata NS accorcia il verde NS al minimo (3 s)",
   "durata": {"variabile": "OUT_NS_Verde", "valore": true, "min": 2.6, "max": 4.0}},

  {"descrizione": "prenotazione NS consumata",
   "verifica": {"V_L_Ped_NS_Prenotato": false}},

  {"descrizione": "chiamata pedonale EO: accorcia il verde EO al minimo",
   "impulso": ["V_P_Chiam_Ped_EO"],
   "attendi": 0.5,
   "verifica": {"V_L_Ped_EO_Prenotato": true}},

  {"descrizione": "verde EO accorciato dalla chiamata EO",
   "durata": {"variabile": "OUT_EO_Verde", "valore": true, "min": 2.6, "max": 4.0}},

  {"descrizione": "modalita NOTTE: giallo lampeggiante, rossi spenti",
   "set": {"V_S_Notte": true},
   "attendi": 1.2,
   "verifica": {"V_L_Notte": true, "OUT_NS_Rosso": false, "OUT_EO_Rosso": false,
                "OUT_NS_Verde": false, "OUT_EO_Verde": false}},

  {"descrizione": "il giallo notturno lampeggia davvero",
   "durata": {"variabile": "OUT_NS_Giallo", "valore": true, "min": 0.3, "max": 0.8}},

  {"descrizione": "ritorno in automatico",
   "set": {"V_S_Notte": false},
   "attendi": 2,
   "verifica": {"V_L_Notte": false}},

  {"descrizione": "EMERGENZA: tutto rosso, verdi e pedonali spenti",
   "set": {"IN_Emergenza": true},
   "attendi": 1.5,
   "verifica": {"OUT_NS_Rosso": true, "OUT_EO_Rosso": true,
                "OUT_NS_Verde": false, "OUT_EO_Verde": false,
                "OUT_NS_Giallo": false, "OUT_EO_Giallo": false,
                "OUT_Ped_NS_Verde": false, "OUT_Ped_EO_Verde": false,
                "V_L_Emergenza": true}},

  {"descrizione": "guasto lampada rossa NS: resta in emergenza",
   "set": {"IN_Emergenza": false, "IN_Guasto_Rosso_NS": true},
   "attendi": 1,
   "verifica": {"V_L_Emergenza": true, "OUT_NS_Verde": false}},

  {"descrizione": "guasto rientrato: il ciclo riparte dalla fase 1",
   "set": {"IN_Guasto_Rosso_NS": false},
   "attendi": 1.5,
   "verifica": {"V_L_Emergenza": false, "OUT_NS_Verde": true, "OUT_EO_Rosso": true}}
 ]
}
